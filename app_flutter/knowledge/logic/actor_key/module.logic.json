      "behaviour": {
        "steps": [
          {
            "kind": "compute",
            "detail": "rnd = Random.secure()"
          },
          {
            "kind": "init",
            "detail": "b = List<int>.generate(16, (_) => rnd.nextInt(256))"
          },
          {
            "kind": "effect",
            "detail": "b[6] = (b[6] & 0x0f) | 0x40"
          },
          {
            "kind": "effect",
            "detail": "b[8] = (b[8] & 0x3f) | 0x80"
          },
          {
            "kind": "compute",
            "detail": "out = StringBuffer()"
          },
          {
            "kind": "loop",
            "detail": "for var i = 0; i < 16; i++"
          },
          {
            "kind": "effect",
            "detail": "out.write(b[i].toRadixString(16).padLeft(2, '0'))"
          },
          {
            "kind": "branch",
            "detail": "if i == 3 || i == 5 || i == 7 || i == 9"
          },
          {
            "kind": "return",
            "detail": "out.toString()"
          }
        ]
      },
