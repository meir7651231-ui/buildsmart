      "behaviour": {
        "steps": [
          {
            "kind": "precond",
            "detail": "if !_throttled.contains(name) → return false"
          },
          {
            "kind": "compute",
            "detail": "now = DateTime.now()"
          },
          {
            "kind": "compute",
            "detail": "last = _lastEmittedAt[name]"
          },
          {
            "kind": "precond",
            "detail": "if last != null && now.difference(last) < _minInterval → return true"
          },
          {
            "kind": "effect",
            "detail": "_lastEmittedAt[name] = now"
          },
          {
            "kind": "return",
            "detail": "false"
          }
        ]
