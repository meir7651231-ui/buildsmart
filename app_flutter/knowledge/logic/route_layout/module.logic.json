      "behaviour": {
        "steps": [
          {
            "kind": "init",
            "detail": "p = const Vec3(0, 0, 0)"
          },
          {
            "kind": "init",
            "detail": "f = const Vec3(1, 0, 0)"
          },
          {
            "kind": "init",
            "detail": "u = const Vec3(0, 1, 0)"
          },
          {
            "kind": "init",
            "detail": "out = <Placement>[]"
          },
          {
            "kind": "loop",
            "detail": "for final el in route"
          },
          {
            "kind": "compute",
            "detail": "delta = layoutDeltaFor(el.family.label, el.od, od2: el.od2)"
          },
          {
            "kind": "branch",
            "detail": "if delta == null → continue"
          },
          {
            "kind": "compute",
            "detail": "b = _dirVec(el.dir, f, u)"
          },
          {
            "kind": "effect",
            "detail": "out.add(Placement(family: el.family.label, od: el.od, position: p, forward: f, up: u))"
          },
          {
            "kind": "compute",
            "detail": "bendAxis = delta.turn != 0 ? b : u"
          },
          {
            "kind": "effect",
            "detail": "p = p + f.scale(delta.ex) + bendAxis.scale(delta.ey)"
          },
          {
            "kind": "branch",
            "detail": "if delta.turn != 0"
          },
          {
            "kind": "branch",
            "detail": "if delta.terminal → break"
          },
          {
            "kind": "return",
            "detail": "out"
          }
        ]
