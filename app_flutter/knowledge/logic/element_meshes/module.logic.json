      "behaviour": {
        "steps": [
          {
            "kind": "compute",
            "detail": "c = math.cos(rotZ)"
          },
          {
            "kind": "compute",
            "detail": "s = math.sin(rotZ)"
          },
          {
            "kind": "init",
            "detail": "p = <double>[]"
          },
          {
            "kind": "init",
            "detail": "n = <double>[]"
          },
          {
            "kind": "loop",
            "detail": "for var i = 0; i < m.vertexCount; i++"
          },
          {
            "kind": "compute",
            "detail": "x = m.positions[i * 3]"
          },
          {
            "kind": "compute",
            "detail": "y = m.positions[i * 3 + 1]"
          },
          {
            "kind": "compute",
            "detail": "z = m.positions[i * 3 + 2]"
          },
          {
            "kind": "effect",
            "detail": "p.addAll([c * x - s * y + tx, s * x + c * y + ty, z + tz])"
          },
          {
            "kind": "compute",
            "detail": "nx = m.normals[i * 3]"
          },
          {
            "kind": "compute",
            "detail": "ny = m.normals[i * 3 + 1]"
          },
          {
            "kind": "compute",
            "detail": "nz = m.normals[i * 3 + 2]"
          },
          {
            "kind": "effect",
            "detail": "n.addAll([c * nx - s * ny, s * nx + c * ny, nz])"
          },
          {
            "kind": "return",
            "detail": "Mesh(p, n, m.indices)"
          }
        ]
