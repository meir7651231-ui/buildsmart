#!/bin/bash
# פרוטוקול BuildSmart — pre-push
# תיקון באג #23: בודק שכל commit עבר את pre-commit + ענף יעד נכון

REMOTE="$1"
URL="$2"

# ═══ ענפי-פרוטוקול — build web רץ רק על ענפים שבחרו לפרוטוקול ═══
_PP_BRANCH=$(git branch --show-current 2>/dev/null || echo "")
_PP_PROTO_BRANCHES=("claude/whats-happening-LyY9G")
_PP_IS_PROTO=0
for _pb in "${_PP_PROTO_BRANCHES[@]}"; do
    [[ "$_PP_BRANCH" == "$_pb" ]] && _PP_IS_PROTO=1 && break
done

PROTECTED_REMOTES="main|master|production"

while read local_ref local_sha remote_ref remote_sha; do
    # חסום push ל-main/master ללא אישור
    if echo "$remote_ref" | grep -qE "refs/heads/($PROTECTED_REMOTES)$"; then
        if [[ ! -f "$(git rev-parse --show-toplevel)/.allow_push_main" ]]; then
            echo "❌ חסום: push לרfn $remote_ref ללא אישור מפורש" >&2
            echo "   צור קובץ .allow_push_main עם הוראה לדחיפה" >&2
            exit 1
        fi
    fi

    # חסום force push (גם אם PreToolUse פספס)
    if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo "❌ חסום: השרת קדימה — force push פוגע בהיסטוריה" >&2
            echo "   משוך עדכונים: git pull --rebase" >&2
            exit 1
        fi
    fi

    # בדוק שכל commit חדש מכיל גוף הודעה תקין
    BASE_SHA="${remote_sha:-$(git merge-base HEAD origin/main 2>/dev/null || echo)}"
    if [[ -n "$BASE_SHA" && "$BASE_SHA" != "0000000000000000000000000000000000000000" ]]; then
        EMPTY=$(git log --format="%h %s" "${BASE_SHA}..${local_sha}" 2>/dev/null | awk '{if(length($0)<25){print $1; exit}}')
        if [[ -n "$EMPTY" ]]; then
            echo "❌ commit עם הודעה קצרה מדי: $EMPTY" >&2
            exit 1
        fi
    fi
done

# ═══ fast-gate: רץ רק על ענפי-פרוטוקול ═══
if [[ "$_PP_IS_PROTO" -eq 0 ]]; then
    exit 0
fi

# ═══ fast-gate (לקח #72): build web המלא רץ כאן (תנאי-יציאה-מהתור), לא ב-commit ═══
# build web release (~2-4 דק') הוצא מ-pre-commit כדי לא להרוג איטרציה. כאן הוא רץ
# פעם אחת לפני push — תופס שגיאות-build שלא נתפסו ב-analyze/test המקומי.
REPO_ROOT_PP="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -n "$REPO_ROOT_PP" && -z "${BUILDSMART_SKIP_BUILD:-}" ]]; then
    for cand in "/home/user/flutter/bin" "/c/flutter/bin" "$HOME/flutter/bin" \
                "/usr/local/flutter/bin" "/opt/homebrew/opt/flutter/bin" "/opt/flutter/bin"; do
        [[ -d "$cand" ]] && PATH="$cand:$PATH"
    done
    if command -v flutter >/dev/null 2>&1 && [[ -d "$REPO_ROOT_PP/app_flutter" ]]; then
        echo "  🏗️  pre-push: flutter build web --release ..."
        if ( cd "$REPO_ROOT_PP/app_flutter" \
             && bash "$REPO_ROOT_PP/scripts/gen_version.sh" 2>/dev/null \
             && BUILD_PP=$(flutter build web --release --no-pub 2>&1) \
             && ! echo "$BUILD_PP" | grep -qE "^Error|Failed to" ); then
            echo "  ✅ build web עבר"
        else
            echo "❌ pre-push: build web נכשל — תקן לפני push (חירום: BUILDSMART_SKIP_BUILD=1)" >&2
            exit 1
        fi
    fi
fi

exit 0
