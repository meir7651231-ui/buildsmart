#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════
#  BuildSmart Protocol v2 — modular pre-commit
# ═══════════════════════════════════════════════════════════════════════════
#  WHAT CHANGED vs v1 (see PROTOCOL_V2.md for the full OLD->NEW mapping):
#   - SINGLE SOURCE OF TRUTH: protocol/gates.tsv lists every real gate. A new
#     gate `reg` FAILS the commit if the set of ids emitted here != the
#     registry's `enforced` set. Registry and code can no longer drift.
#   - CONTENT GATES MOVED TO DART: every brittle string/content gate (emoji,
#     RTL, secrets, dark-surface, persistence-key, kLipskeyCatalog,
#     antipattern-recurrence, ...) now runs in tool/protocol_check.dart — a
#     deterministic, OS-independent engine — instead of MSYS-fragile bash grep.
#     This kills the #1 recurring bug class (lesson #52). Findings are re-emitted
#     through err()/warn() so retry/fingerprint bookkeeping is unchanged.
#   - DEFECTS FIXED: old `err "105"` mislabel (commit-msg-missing) is now its
#     correct id `7c`; the 15==83 duplicate is merged into gate 15; cancelled/
#     moved/removed entries (34/59/61/76/83/100) are documented in the registry
#     and no longer inflate the live count.
#   - STRUCTURE: one bash function per gate-group + a thin run() at the bottom.
#     Behavior (branch-scoping, emergency-disable, fail-fast barrier, tiering,
#     rebase/amend replay-skip, baseline tracking, retry fingerprint) is
#     PRESERVED.
#
#  Saved in-repo at .githooks/ — applies to every model and every clone.
#  Any protocol violation = hard block.
#
#  v3 (this revision) closes red-team roots R3/R6 in the cheap tier:
#   - R3 FAIL-CLOSED: the Dart engine's exit code is captured; any non-zero that
#     is not "findings(2)" is a HARD block (never 2>/dev/null swallowed). mktemp
#     failure aborts. analyze WARNINGS are fatal for changed files.
#   - R6 PROVE-RAN: each gate appends its id to a runtime ledger; parity compares
#     that ledger (not a static constant) to gates.tsv. The engine is hash-pinned
#     and its --self-test runs as a BLOCKING gate. Malformed tsv rows FAIL.
# ═══════════════════════════════════════════════════════════════════════════

# ── flutter on PATH (Linux / macOS Intel+ARM / Windows Git Bash) ──
for candidate in \
    "/home/user/flutter/bin" \
    "/c/flutter/bin" \
    "$HOME/flutter/bin" \
    "/usr/local/flutter/bin" \
    "/opt/homebrew/opt/flutter/bin" \
    "/opt/flutter/bin"; do
    [[ -d "$candidate" ]] && PATH="$candidate:$PATH"
done
export PATH

if ! command -v flutter >/dev/null 2>&1; then
    echo "❌ flutter לא נמצא ב-PATH" >&2
    echo "   הוסף flutter/bin ל-PATH או התקן Flutter" >&2
    exit 1
fi

# ═══ K7 / DX6 (v7) — ENFORCEMENT vs LOCAL Flutter version ═══
# DX6 reconciled local==CI==ship to ONE real installable SDK (3.29.3). The old
# 3.44.0 pin did not exist as a stable release → CI could never go green. We still
# PRINT a notice (never silent) if a dev's local Flutter drifts off the pinned
# version; CI's version-parity gate is the hard anchor. We do not BLOCK locally
# (a dev may transiently have another SDK), but with the pins reconciled this
# notice should now stay quiet in the normal case.
FLUTTER_ENFORCE_VERSION="3.29.3"
_LOCAL_FLUTTER_VER=$(flutter --version 2>/dev/null | grep -oE "Flutter [0-9]+\.[0-9]+\.[0-9]+" | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" | head -1)
if [[ -n "$_LOCAL_FLUTTER_VER" && "$_LOCAL_FLUTTER_VER" != "$FLUTTER_ENFORCE_VERSION" ]]; then
    echo "ℹ️  K7 NOTICE: local Flutter $_LOCAL_FLUTTER_VER ≠ enforcement/ship $FLUTTER_ENFORCE_VERSION." >&2
    echo "   CI builds on $FLUTTER_ENFORCE_VERSION — 'passes locally' ≠ 'passes CI/ship'. See PROTOCOL_V4.md (K7)." >&2
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ═══ branch-scoping — only protocol branches get full enforcement ═══
# EXCEPTION (K3): PROTOCOL_AUDIT_MODE bypasses branch-scoping. CI runs the gate-
# runner in audit mode to produce the registry-parity ledger regardless of the
# branch it is checking; audit mode is non-blocking and only emits a ledger.
_CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "")
_PROTO_BRANCHES=("claude/whats-happening-LyY9G")
_IS_PROTO=0
for _pb in "${_PROTO_BRANCHES[@]}"; do
    [[ "$_CURRENT_BRANCH" == "$_pb" ]] && _IS_PROTO=1 && break
done
if [[ "$_IS_PROTO" -eq 0 && -z "${PROTOCOL_AUDIT_MODE:-}" ]]; then
    exit 0
fi

# ═══ emergency disable (critical protocol-bug use only) ═══
if [[ -n "${BUILDSMART_EMERGENCY_DISABLE:-}" ]]; then
    TOKEN_FILE="$REPO_ROOT/.emergency_token"
    if [[ -f "$TOKEN_FILE" ]]; then
        EXPECTED=$(tr -d '[:space:]' < "$TOKEN_FILE")
        GIVEN=$(echo "${BUILDSMART_EMERGENCY_DISABLE}" | tr -d '[:space:]')
        if [[ ${#EXPECTED} -ge 16 && "$GIVEN" == "$EXPECTED" ]]; then
            echo "⚠️  EMERGENCY DISABLE פעיל — פרוטוקול מושהה. רשום ב-stuck_log." >&2
            echo "[$(date -Iseconds)] EMERGENCY_DISABLE used — pre-commit bypassed" \
                >> "$REPO_ROOT/.git/protocol_audit.log"
            exit 0
        fi
    fi
    echo "🔒 BUILDSMART_EMERGENCY_DISABLE לא תקין — token חסר/לא נכון." >&2
fi

cd "$REPO_ROOT/app_flutter" || exit 1

# ── result accumulators + emitters ──────────────────────────────────────
FAIL=0
WARN=0
FAILED_GATES=""        # ids that failed — feeds retry classification

# ═══════════════════════════════════════════════════════════════════════════
#  K3 (v4) — AUDIT MODE. When PROTOCOL_AUDIT_MODE=1 the runner does NOT block
#  the commit; it runs every gate's body over a FORCED-APPLICABLE synthetic
#  context (so each gate's check executes and records `ran <id>` AFTER it runs),
#  skips the slow Flutter tier, then dumps the genuine runtime ledger to
#  $PROTOCOL_AUDIT_LEDGER. CI diffs that ledger against gates.tsv — a REAL
#  registry⇄runtime parity (no `cp enforced claimed` self-comparison), and a
#  gate whose CHECK was deleted (but whose `ran` line was left) no longer records
#  because `ran` is emitted AFTER the check, not at function entry.
PROTOCOL_AUDIT_MODE="${PROTOCOL_AUDIT_MODE:-}"

# K3 — RUNTIME GATE LEDGER. A gate records its id HERE *after* its check has
# executed (`ran <id>` placed after the check, never at function entry). gate
# `reg` compares THIS ledger to protocol/gates.tsv: a commented-out/short-
# circuited check never reaches its `ran` and parity FAILS — proving it ran.
RAN_LEDGER="$(mktemp 2>/dev/null)" || { echo "❌ mktemp נכשל — fail closed" >&2; exit 1; }
ran() { local _g; for _g in "$@"; do echo "$_g" >> "$RAN_LEDGER"; done; }
# K3 — `napp` (not-applicable): a gate whose APPLICABILITY guard was reached and
# evaluated FALSE this commit (e.g. the flutter tier on a no-code commit). It
# does NOT record `ran` (the check body did not execute — exactly what K3 wants),
# but it DOES prove the gate's decision logic exists. Registry parity treats
# `ran ∪ napp` as "exercised": a SILENTLY-DELETED gate records NEITHER and fails.
# In AUDIT mode every guard is forced true, so gates record real `ran`.
NAPP_LEDGER="$(mktemp 2>/dev/null)" || { echo "❌ mktemp נכשל (napp) — fail closed" >&2; exit 1; }
napp() { local _g; for _g in "$@"; do echo "$_g" >> "$NAPP_LEDGER"; done; }
# err()/warn() also imply the gate ran (a finding can only come from a gate that
# executed), so they record too — covers the Dart engine's emitted ids. In AUDIT
# mode err() is NON-fatal (we are exercising paths, not blocking a commit).
err()  {
    echo ""; echo "❌ [שער $1] $2"; echo "   → $3"; ran "$1"
    if [[ -z "$PROTOCOL_AUDIT_MODE" ]]; then FAIL=$((FAIL+1)); FAILED_GATES="$FAILED_GATES,$1"; fi
}
warn() { echo "⚠️  [שער $1] $2"; WARN=$((WARN+1)); ran "$1"; }

# ═══════════════════════════════════════════════════════════════════════════
#  DX2 (v7) — flutter test `--reporter json` parsers. ONE authoritative stream
#  drives BOTH the failure count and the failure names, so gate 32's count-branch
#  and name-branch can never disagree (the old compact-reporter scrape could).
#  Pure awk (already a hook dependency) — portable to MSYS/Git-Bash. A "real"
#  failure = a testDone whose result != success AND hidden != true (loader/
#  synthetic tests are hidden:true). This is STRICTER than a printed summary line:
#  a test that prints "+99 -0" as data cannot forge a testDone event.
# ═══════════════════════════════════════════════════════════════════════════
# Emits one line per FAILED test:  <suite_basename>\t<test_name>
parse_json_failures() {
    awk '
        # suite id -> basename(path)
        /"type":"suite"/ {
            sid=""; sp="";
            if (match($0, /"id":[0-9]+/))   { sid=substr($0,RSTART+5,RLENGTH-5) }
            if (match($0, /"path":"([^"\\]|\\.)*"/)) {
                sp=substr($0,RSTART+8,RLENGTH-9)
                gsub(/^.*\//,"",sp)            # basename
            }
            if (sid!="") suite[sid]=sp
            next
        }
        # test id -> name + suiteID  (from testStart)
        /"type":"testStart"/ {
            id=""; nm=""; ssid="";
            if (match($0, /"id":[0-9]+/))      { id=substr($0,RSTART+5,RLENGTH-5) }
            if (match($0, /"name":"([^"\\]|\\.)*"/)) { nm=substr($0,RSTART+8,RLENGTH-9) }
            if (match($0, /"suiteID":[0-9]+/)) { ssid=substr($0,RSTART+10,RLENGTH-10) }
            if (id!="") { name[id]=nm; tsuite[id]=ssid }
            next
        }
        # testDone: a non-success, non-hidden test is a real failure
        /"type":"testDone"/ {
            tid=""; res=""; hid="false";
            if (match($0, /"testID":[0-9]+/))   { tid=substr($0,RSTART+9,RLENGTH-9) }
            if (match($0, /"result":"[a-z]+"/)) { res=substr($0,RSTART+10,RLENGTH-11) }
            if (match($0, /"hidden":true/))     { hid="true" }
            if (res!="" && res!="success" && hid!="true") {
                printf "%s\t%s\n", suite[tsuite[tid]], name[tid]
            }
        }
    '
}
# Emits the count of PASSED, non-hidden tests (the live "tests:" total — gate 33).
parse_json_passcount() {
    awk '
        /"type":"testDone"/ {
            res=""; hid="false";
            if (match($0, /"result":"[a-z]+"/)) { res=substr($0,RSTART+10,RLENGTH-11) }
            if (match($0, /"hidden":true/))     { hid="true" }
            if (res=="success" && hid!="true") c++
        }
        END { print c+0 }
    '
}

# ═══════════════════════════════════════════════════════════════════════════
#  H1 / B3 (v8) — emit a file's CODE lines with `// line comments` and quoted
#  string literals stripped, so a symbol-reference grep matches ACTUAL CODE only
#  (not a `// MySymbol` comment or a "MySymbol" string). Used by the coverage
#  checks (gate 42/116, helper-test gate 56) and by B3's smarter test selection.
#  Conservative: removes `//`-to-EOL and the CONTENTS of single/double-quoted
#  literals (keeps the quotes as empty so structure survives). Block comments are
#  rare in tests and left as-is (a worst case only ADDS a match → fail-safe).
# ═══════════════════════════════════════════════════════════════════════════
_code_lines() {
    # awk state machine (portable; awk is already a hook dependency). Strips, in
    # order of precedence: multi-line `/* … */` block comments, `// …` line
    # comments, and the CONTENTS of single/double-quoted string literals (escapes
    # honoured). Keeps the surrounding code structure so a `\bSymbol\b` grep on the
    # output matches ONLY a real code reference — not a `// Symbol` comment, a
    # `/* Symbol */`, or a "Symbol" string. (H1 honest-coverage requirement.)
    awk '
    {
        line = $0; out = ""; i = 1; n = length(line)
        while (i <= n) {
            c = substr(line, i, 1); two = substr(line, i, 2)
            if (inblock) { if (two == "*/") { inblock = 0; i += 2 } else { i += 1 } continue }
            if (instr) {
                if (c == "\\") { i += 2; continue }
                if (c == q) { instr = 0; out = out q }
                i += 1; continue
            }
            if (two == "//") { break }
            if (two == "/*") { inblock = 1; i += 2; continue }
            if (c == "\"" || c == "\047") { instr = 1; q = c; out = out c; i += 1; continue }
            out = out c; i += 1
        }
        print out
    }
    ' "$1" 2>/dev/null
}

# ═══════════════════════════════════════════════════════════════════════════
#  DX3 (v7) / B3 (v8) — CHANGED-FILES test scoping for the LOCAL hook ONLY.
#  Maps each staged lib/*.dart to its sibling test(s) + tests that REFERENCE its
#  symbols in code (B3 smarter selection) + a small CRITICAL subset. Returns a
#  space-separated list of `test/*.dart` paths, OR "" to mean "run the WHOLE
#  suite" (used when a broad/shared/ambiguous file changed, when only tests
#  changed, or when mapping is uncertain — fail toward MORE tests, never fewer).
#  CI/pre-push ALWAYS run the full suite, so this only trades a little local speed
#  for zero security loss. The CALLER prints a clear "scoped run — N tests; full
#  suite runs in CI" notice (B3) so a dev is never surprised by a CI-only failure.
# ═══════════════════════════════════════════════════════════════════════════
# CRITICAL subset — protocol/contract tests that must run on EVERY code commit.
_DX3_CRITICAL="knowledge_protocol_test stuck_regression_test protocol_security_test \
               regression_gate_test wiring_test smartproduct_contract_test"
select_test_targets() {
    local _changed _f _base _t _cand _targets="" _seen=" " _libchanged="" _crit
    _changed=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
                 | grep -E '^app_flutter/(lib|test)/.*\.dart$' | sed 's#^app_flutter/##')
    # No .dart staged at all → caller still runs (analyze); return "" (whole suite
    # is harmless but the tier only reaches here when NEEDS_FLUTTER matched).
    [[ -z "$_changed" ]] && { echo ""; return; }
    while IFS= read -r _f; do
        [[ -z "$_f" ]] && continue
        case "$_f" in
            # Shared/broad surfaces or non-mappable changes → WHOLE suite (safe).
            lib/state/*|lib/providers.dart|lib/main.dart|lib/app.dart)
                echo ""; return ;;
            test/*_test.dart)
                # a staged test file: run exactly it
                _cand="$_f" ;;
            test/*)
                # non-_test test helper changed → WHOLE suite (helpers fan out)
                echo ""; return ;;
            lib/*.dart)
                _libchanged=1
                _base=$(basename "$_f" .dart)
                _cand=""
                # direct sibling: test/<base>_test.dart
                [[ -f "test/${_base}_test.dart" ]] && _cand="test/${_base}_test.dart"
                # also any test whose name contains the base (e.g. foo -> foo_*_test)
                for _t in test/*"${_base}"*_test.dart; do
                    [[ -f "$_t" ]] && _cand="$_cand $_t"
                done
                # B3 (v8): SMARTER selection AS A FALLBACK. When NO name-sibling
                # test exists, a change's real covering test may still live under a
                # different name (renamed/split test). Rather than fall straight to
                # the WHOLE suite, look for a test that REALLY covers the file — a
                # genuine `import '…/<base>.dart'` OR a reference to one of the
                # file's public symbols in REAL CODE (comments/strings stripped, H1
                # rule). If found, run exactly those (+ the critical subset); else
                # WHOLE. We do this ONLY when the sibling search found nothing, so a
                # sibling-tested file keeps the fast ~12s path (it is not diluted by
                # every test that happens to mention a common symbol). CI runs the
                # full suite regardless, so a missed non-sibling cover only ever
                # costs a re-run, never a security gap.
                if [[ -z "$_cand" ]]; then
                    local _csym _csyms _ct
                    _csyms=$(grep -hoE '^(class|enum|mixin|extension)[[:space:]]+[A-Z][A-Za-z0-9_]+|^[A-Za-z_][A-Za-z0-9_<>, ?]*[[:space:]]+[a-z][A-Za-z0-9_]*[[:space:]]*\(' "$_f" 2>/dev/null \
                              | grep -oE '[A-Z][A-Za-z0-9_]+|[a-z][A-Za-z0-9_]*[[:space:]]*\(' \
                              | sed -E 's/[[:space:]]*\($//' | sort -u | head -20)
                    for _ct in test/*_test.dart; do
                        [[ -f "$_ct" ]] || continue
                        if grep -qE "import[[:space:]]+['\"][^'\"]*\b$_base\.dart['\"]" "$_ct" 2>/dev/null; then
                            _cand="$_cand $_ct"; continue
                        fi
                        for _csym in $_csyms; do
                            if _code_lines "$_ct" | grep -qE "\b$_csym\b" 2>/dev/null; then
                                _cand="$_cand $_ct"; break
                            fi
                        done
                    done
                fi
                # a lib file with NO discoverable covering test → WHOLE suite
                # (do not under-test; gate 42/56 separately demand a test exists)
                if [[ -z "$_cand" ]]; then echo ""; return; fi
                ;;
            *) echo ""; return ;;
        esac
        for _t in $_cand; do
            case "$_seen" in *" $_t "*) : ;; *) _targets="$_targets $_t"; _seen="$_seen$_t ";; esac
        done
    done <<<"$_changed"
    # Always fold in the critical subset (only those that exist on disk).
    for _crit in $_DX3_CRITICAL; do
        _t="test/${_crit}.dart"
        [[ -f "$_t" ]] || continue
        case "$_seen" in *" $_t "*) : ;; *) _targets="$_targets $_t"; _seen="$_seen$_t ";; esac
    done
    # Trim leading space.
    echo "${_targets# }"
}

# ═══════════════════════════════════════════════════════════════════════════
#  DX4 (v7) + H1 (v8) — gate 42 trigger: STRICTER, SMARTER, HONEST coverage.
#  v7: err 42 only on a NEW public top-level symbol (class/enum/mixin/extension/
#       function) in lib/(logic|data) with no covering test.
#  H1 (v8) TWO fixes:
#    (1) WIDER detection — also catch new public top-level VARS / CONSTS / GETTERS
#        (extensions already covered), and also scan lib/state/ (a new untested
#        public provider/state symbol is exactly the risk; v7 missed those).
#    (2) HONEST coverage — the "covered" check matches the symbol in REAL CODE
#        (comments + string literals stripped via _code_lines) or a real import of
#        the file. A `// MySymbol` comment or "MySymbol" string no longer counts.
#  KEEP the v7 DX win: editing an EXISTING tested symbol adds no NEW symbol → no
#  demand. Only a genuinely-NEW untested public API is blocked; CI runs full suite.
# Echoes the FIRST "<file>::<symbol>" that is a newly-added public top-level
# symbol lacking any REAL-CODE covering test; empty if none.
staged_new_untested_symbol() {
    local _files _file _syms _sym _base _covered _t _diff
    _files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
               | grep -E '^app_flutter/lib/(logic|data|state)/.*\.dart$' | sed 's#^app_flutter/##')
    [[ -z "$_files" ]] && { echo ""; return; }
    while IFS= read -r _file; do
        [[ -z "$_file" ]] && continue
        # $_file is repo-root-relative WITHOUT the app_flutter/ prefix (stripped
        # above). The runner cd'd into app_flutter/, so the diff pathspec is the
        # CWD-relative path (lib/...), NOT app_flutter/lib/... (which from here
        # would match nothing and silently skip — a fail-OPEN we must avoid).
        _diff=$(git diff --cached -- "$_file" 2>/dev/null)
        # NEW public top-level symbols ADDED in this diff:
        #  + class/enum/mixin/extension Name        (Name starts uppercase)
        #  + <ReturnType...> funcName(  /  + funcName(   at column 0 (top-level),
        #    public (no leading underscore). We read the char AFTER the diff '+'.
        _syms=$(printf '%s\n' "$_diff" \
            | grep -E '^\+(class|enum|mixin|extension)[[:space:]]+[A-Z][A-Za-z0-9_]+' \
            | sed -E 's/^\+(class|enum|mixin|extension)[[:space:]]+([A-Z][A-Za-z0-9_]+).*/\2/')
        # top-level public functions: a '+'-added line, NOT indented (next char is
        # not a space), containing `name(` where name is a public identifier and
        # the line is not a control keyword / field / annotation.
        _syms="$_syms
$(printf '%s\n' "$_diff" \
            | grep -E '^\+[A-Za-z_][A-Za-z0-9_<>, ?]*[[:space:]]+[a-z][A-Za-z0-9_]*[[:space:]]*\(' \
            | grep -vE '^\+[[:space:]]' \
            | grep -vE '\b(if|for|while|switch|return|assert|case|catch)\b' \
            | sed -E 's/^\+[A-Za-z_][A-Za-z0-9_<>, ?]*[[:space:]]+([a-z][A-Za-z0-9_]*)[[:space:]]*\(.*/\1/')"
        # H1 (v8): top-level public VARS / CONSTS / FINALS (column 0 = top-level,
        # public lowercase name): `+ final|const|var|late|<Type> name = …`.
        _syms="$_syms
$(printf '%s\n' "$_diff" \
            | grep -E '^\+(final|const|var|late|[A-Z][A-Za-z0-9_<>, ?]*)[[:space:]]+[a-z][A-Za-z0-9_]*[[:space:]]*=' \
            | grep -vE '^\+[[:space:]]' \
            | sed -E 's/^\+(final|const|var|late|[A-Z][A-Za-z0-9_<>, ?]*)[[:space:]]+([a-z][A-Za-z0-9_]*)[[:space:]]*=.*/\2/')"
        # H1 (v8): top-level public GETTERS: `+ <Type> get name …`.
        _syms="$_syms
$(printf '%s\n' "$_diff" \
            | grep -E '^\+[A-Za-z_][A-Za-z0-9_<>, ?]*[[:space:]]+get[[:space:]]+[a-z][A-Za-z0-9_]*' \
            | grep -vE '^\+[[:space:]]' \
            | sed -E 's/^\+[A-Za-z_][A-Za-z0-9_<>, ?]*[[:space:]]+get[[:space:]]+([a-z][A-Za-z0-9_]*).*/\1/')"
        _syms=$(printf '%s\n' "$_syms" | grep -E '^[A-Za-z][A-Za-z0-9_]*$' | sort -u)
        [[ -z "$_syms" ]] && continue
        _base=$(basename "$_file" .dart)
        for _sym in $_syms; do
            _covered=""
            # H1 (v8): covering test = ANY test/*_test.dart that references the
            # symbol in REAL CODE (comments + strings stripped via _code_lines) OR
            # imports the changed file. A `// $_sym` comment / "$_sym" string no
            # longer satisfies coverage — the test must actually USE the symbol.
            for _t in test/*_test.dart; do
                [[ -f "$_t" ]] || continue
                if grep -qF "$_base.dart" "$_t" 2>/dev/null; then _covered=1; break; fi
                if _code_lines "$_t" | grep -qE "\b$_sym\b" 2>/dev/null; then _covered=1; break; fi
            done
            [[ -n "$_covered" ]] && continue
            echo "$_file::$_sym"
            return
        done
    done <<<"$_files"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
#  DX5 (v7) — gate 116 (UI visual-verify) second satisfying path.
#  OLD: a screens/widgets change REQUIRED a staged knowledge/visual_log.md entry,
#       even for a non-visual edit (a manufactured "screenshot note" was the only
#       way out → performative). NEW: gate 116 is ALSO satisfied when EVERY
#       changed UI file is covered by a WIDGET TEST that references the changed
#       widget (a real `testWidgets`/`pumpWidget` test naming the class, or
#       importing the file). This is NOT weaker: an automated widget test is a
#       STRONGER verification artefact than a hand-written note, and the visual_log
#       path is unchanged. CI re-runs the full suite, so the widget test must
#       actually pass. Returns the FIRST uncovered UI file, or "" if all covered.
staged_ui_covered_by_widget_test() {
    local _files _file _classes _cls _covered _t _imp _base
    _files=$(printf '%s\n' "$1" | grep -E '^app_flutter/lib/(screens|widgets)/.*\.dart$' | sed 's#^app_flutter/##')
    [[ -z "$_files" ]] && { echo ""; return; }
    while IFS= read -r _file; do
        [[ -z "$_file" ]] && continue
        _base=$(basename "$_file")
        # widget classes declared in (or added to) the file — match on disk so an
        # edit to an existing widget is covered too, not only newly-added classes.
        _classes=$(grep -hoE 'class[[:space:]]+[A-Z][A-Za-z0-9_]+[[:space:]]+extends[[:space:]]+(Stateless|Stateful|Consumer|HookConsumer|HookWidget)' "$_file" 2>/dev/null \
                     | sed -E 's/class[[:space:]]+([A-Z][A-Za-z0-9_]+).*/\1/' | sort -u)
        _covered=""
        # search widget tests: a _test.dart that uses widget-test machinery AND
        # references one of the classes (H1: in REAL CODE, not a comment/string)
        # OR imports the changed file path.
        for _t in test/*_test.dart; do
            [[ -f "$_t" ]] || continue
            grep -qE 'testWidgets|pumpWidget' "$_t" 2>/dev/null || continue
            if grep -qF "$_base" "$_t" 2>/dev/null; then _covered=1; break; fi
            for _cls in $_classes; do
                if _code_lines "$_t" | grep -qE "\b$_cls\b" 2>/dev/null; then _covered=1; break; fi
            done
            [[ -n "$_covered" ]] && break
        done
        [[ -n "$_covered" ]] && continue
        echo "$_file"
        return
    done <<<"$_files"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
#  Dart content engine — run ALL string/content gates deterministically.
#  Replaces the MSYS-fragile bash greps of v1. We dump the staged diff once and
#  let tool/protocol_check.dart emit `ERR|WARN<TAB>id<TAB>msg`, which we re-emit
#  through err()/warn() so bookkeeping (FAILED_GATES/fingerprint) is identical
#  to a native bash gate.
# ═══════════════════════════════════════════════════════════════════════════
run_content_engine() {
    local diff_file gi_file names_file out rc sev id msg
    # R3: mktemp must succeed — a failure here must NOT silently skip gates.
    diff_file="$(mktemp)" || { err "reg" "mktemp נכשל (diff)" "fail closed"; return; }
    gi_file="$(mktemp)"   || { err "reg" "mktemp נכשל (gi)" "fail closed"; return; }
    names_file="$(mktemp)" || { err "reg" "mktemp נכשל (names)" "fail closed"; return; }
    # H1 (v6): -c core.quotePath=false so a non-ASCII (Hebrew) filename is its
    # TRUE UTF-8 path in BOTH the diff headers and the names list — not a C-quoted
    # `"…\NNN…"` string that would mis-scope the per-file gates (silent-skip class).
    git -c core.quotePath=false diff --cached > "$diff_file" 2>/dev/null
    git -c core.quotePath=false diff --cached -- "$REPO_ROOT/.gitignore" > "$gi_file" 2>/dev/null
    git -c core.quotePath=false diff --cached --name-only > "$names_file" 2>/dev/null

    # R3: capture the engine exit code. The engine exits 0 (no findings) or 2
    # (ERR findings). ANY OTHER code = the engine crashed / Dart broke / file
    # tampered — that is a HARD block, never swallowed by 2>/dev/null.
    out=$(dart run "$REPO_ROOT/app_flutter/tool/protocol_check.dart" \
            --diff "$diff_file" \
            --names "$names_file" \
            --stuck-log "knowledge/stuck_log.md" \
            --gitignore "$gi_file" \
            --emit-ran 2>"$diff_file.err")
    rc=$?
    if [[ "$rc" -ne 0 && "$rc" -ne 2 ]]; then
        echo "   $(head -5 "$diff_file.err" 2>/dev/null)"
        err "reg" "מנוע התוכן קרס (exit=$rc, לא 0/2) — fail closed" \
            "בדוק dart run tool/protocol_check.dart; ייתכן שיבוש בקובץ המנוע"
    fi
    # R6: RAN lines feed the ledger (prove the engine executed each gate);
    # ERR/WARN lines feed err()/warn() (which also record RAN via `ran`).
    while IFS=$'\t' read -r sev id msg; do
        [[ -z "$id" ]] && continue
        case "$sev" in
            ERR)  err  "$id" "$msg" "ראה PROTOCOL_V3.md / stuck_log.md" ;;
            WARN) warn "$id" "$msg" ;;
            RAN)  ran  "$id" ;;
        esac
    done <<< "$out"
    rm -f "$diff_file" "$gi_file" "$names_file" "$diff_file.err"
}

# ═══════════════════════════════════════════════════════════════════════════
#  R6 — INTEGRITY PIN + BLOCKING SELF-TEST of the content engine.
#  The engine, registry and the scripts the protocol shells out to are pinned by
#  sha256 (protocol/pins.sha256). A tampered engine/registry/script FAILS here,
#  before any gate trusts them. The engine's --self-test is a BLOCKING gate.
# ═══════════════════════════════════════════════════════════════════════════
PROTECTED_PINNED=(
    "app_flutter/tool/protocol_check.dart"
    "app_flutter/tool/protocol_check_selftest.dart"
    "protocol/gates.tsv"
    "scripts/gen_version.sh"
    "app_flutter/scripts/generate_stuck_regression.sh"
    # K4 (v4) — the hooks + workflows are integrity-pinned too: a gutted-but-
    # executable hook or a neutered workflow fails the content-hash check here,
    # locally, before any commit trusts them. (.claude/* is WALL — harness-locked.)
    ".githooks/pre-commit"
    ".githooks/pre-push"
    ".githooks/commit-msg"
    ".github/workflows/protocol-enforce.yml"
    ".github/workflows/deploy.yml"
    "protocol/regression_v5.sh"   # v5 — pin the bash/CI regression suite
    "protocol/regression_v6.sh"   # v6 — pin the H1-H5 regression suite
    "protocol/regression_v7.sh"   # v7 — pin the DX friction-fix regression suite
)
gate_engine_integrity() {
    ran "reg"
    local pins="$REPO_ROOT/protocol/pins.sha256" f have want st
    # Self-test FIRST — proves the engine's logic, OS-independently, as a gate.
    if ! st=$(dart run "$REPO_ROOT/app_flutter/tool/protocol_check.dart" --self-test 2>&1); then
        echo "$st" | grep -E "FAIL|FAILURE" | head -5 | sed 's/^/   /'
        err "reg" "self-test של מנוע התוכן נכשל" "תקן tool/protocol_check.dart"
    fi
    # Hash pin: each pinned file must match protocol/pins.sha256 (if present).
    if [[ -f "$pins" ]]; then
        for f in "${PROTECTED_PINNED[@]}"; do
            [[ -f "$REPO_ROOT/$f" ]] || { err "reg" "קובץ נעול חסר: $f" "שחזר"; continue; }
            want=$(grep -F "  $f" "$pins" 2>/dev/null | awk '{print $1}' | head -1)
            [[ -z "$want" ]] && continue   # not pinned yet — skip (bootstrap)
            have=$(sha256sum "$REPO_ROOT/$f" | awk '{print $1}')
            if [[ "$have" != "$want" ]]; then
                err "reg" "integrity: $f שונה מה-pin" \
                    "אם השינוי מכוון: bash scripts/update_pins.sh && git add protocol/pins.sha256"
            fi
        done
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
#  GROUP: version.g.dart — idempotent generate from git (lesson #72)
# ═══════════════════════════════════════════════════════════════════════════
gate_version_generate() {
    if [[ -f "$REPO_ROOT/scripts/gen_version.sh" ]]; then
        if ! bash "$REPO_ROOT/scripts/gen_version.sh" 2>/tmp/bs_genver.err; then
            err "11" "gen_version נכשל: $(cat /tmp/bs_genver.err 2>/dev/null)" \
                "ודא knowledge/STATUS.md מכיל תווית vX.YY"
        fi
    fi
    if git ls-files --error-unmatch lib/version.g.dart >/dev/null 2>&1; then
        err "11" "version.g.dart עדיין tracked — גישה-C דולפת" \
            "git rm --cached app_flutter/lib/version.g.dart"
    fi
    if git diff --cached --name-only | grep -q "version\.g\.dart"; then
        err "11" "version.g.dart ב-staging (אמור להיות gitignored)" \
            "git reset app_flutter/lib/version.g.dart"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
#  GROUP foundations (1-10)
