# ═══════════════════════════════════════════════════════════════════════════
#  GROUP quality (46-60). Content gates 46/48/50/51/52/54 -> Dart engine.
#  Non-content quality gates remain native bash (path/structure checks).
# ═══════════════════════════════════════════════════════════════════════════
gate_quality() {
    local NEW_DIALOG NEW_TODO NEW_HELPER NEW_DEFINE NEW_DEPS NAME TEST_FILE
    local STAGED_ENV STAGED_TOKEN EMBED_LOGIC
    # S2 (v5): per-check `ran` AFTER each detection runs (48/50/51/52/54 -> engine).
    NEW_DIALOG=$(git diff --cached lib/screens/ 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "showDialog|showModalBottomSheet" | head -1)
    if [[ -n "$NEW_DIALOG" && -z "$STAGED_WIRING" ]]; then
        warn "47" "dialog/sheet חדש — וודא שמופיע ב-WIRING"
    fi
    ran 47
    # 48 print(), 50 dart:html, 51 hard URL, 52 secrets -> Dart engine.

    NEW_TODO=$(git diff --cached lib/ 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "// TODO[^:]|// FIXME[^:]" | head -1)
    [[ -z "$NEW_TODO" ]] || warn "49" "TODO/FIXME בלי הסבר"; ran 49

    # Gate 53 (secret files) — name-only, MSYS-safe, stays bash. Merged the 3 v1
    # `err 53` checks (.env, bypass-token) into one gate body.
    STAGED_ENV=$(git diff --cached --name-only | grep -E "^\.env|\.env\.|credentials" | head -1)
    [[ -z "$STAGED_ENV" ]] || err "53" "קובץ סודות נוסף: $STAGED_ENV" "הסר מ-staging"
    STAGED_TOKEN=$(git diff --cached --name-only | grep -E "^\.(emergency_token|allow_protocol_edit|allow_master_protocol_edit)$" | head -1)
    [[ -z "$STAGED_TOKEN" ]] || err "53" "bypass-token ב-staging: $STAGED_TOKEN" "git reset HEAD $STAGED_TOKEN — local-only בלבד"; ran 53

    # 54 dark ColoredBox -> Dart engine.

    EMBED_LOGIC=$(git diff --cached lib/screens/ 2>/dev/null | grep "^+" | grep -E "if\s*\(.*&&.*&&.*\)" | head -1)
    [[ -z "$EMBED_LOGIC" ]] || warn "55" "לוגיקה מקוננת ב-UI — שקול helper"; ran 55

    NEW_HELPER=$(git diff --cached --name-only | grep -E "^app_flutter/lib/logic/.*_helper\.dart$" | head -1)
    if [[ -n "$NEW_HELPER" ]]; then
        NAME=$(basename "$NEW_HELPER" .dart)
        TEST_FILE="test/${NAME}_test.dart"
        if [[ ! -f "$TEST_FILE" ]]; then
            err "56" "helper חדש ללא test: $NAME" "צור $TEST_FILE"
        else
            # R5: the test must REFERENCE a public symbol from the changed helper —
            # an empty/placeholder test file no longer satisfies the gate. We pull
            # the public top-level names ADDED to the helper and require >=1 in the
            # test (or an import of the helper file).
            local _syms _sym _ok _hbase
            _hbase=$(basename "$NEW_HELPER")
            _ok=""
            if grep -qF "$_hbase" "$TEST_FILE" 2>/dev/null; then _ok=1; fi
            if [[ -z "$_ok" ]]; then
                _syms=$(git diff --cached -- "$NEW_HELPER" | grep "^+" \
                        | grep -oE '\b(class|enum|mixin|extension)\s+[A-Z][A-Za-z0-9_]+|\b[A-Za-z_][A-Za-z0-9_]+\s*\(' \
                        | grep -oE '[A-Z][A-Za-z0-9_]+' | sort -u | head -10)
                for _sym in $_syms; do
                    if grep -qE "\b$_sym\b" "$TEST_FILE" 2>/dev/null; then _ok=1; break; fi
                done
            fi
            [[ -n "$_ok" ]] || err "56" "test קיים אך אינו מתייחס לסמל מ-$NAME" "ודא ש-$TEST_FILE בודק את הפונקציה/מחלקה שהשתנתה"
        fi
    fi
    ran 56   # helper-needs-test detection always runs (body conditional on NEW_HELPER)

    NEW_DEFINE=$(git diff --cached lib/ 2>/dev/null | grep "^+" | grep "fromEnvironment" | head -1)
    [[ -z "$NEW_DEFINE" ]] || warn "58" "fromEnvironment חדש — תעד ב-WIRING"; ran 58

    NEW_DEPS=$(git diff --cached pubspec.yaml 2>/dev/null | awk '
        /^[+-]dependencies:/ { in_prod=1; in_dev=0; next }
        /^[+-]dev_dependencies:/ { in_dev=1; in_prod=0; next }
        /^[+-][a-z]/ && !/^[+-][[:space:]]/ { in_prod=0; in_dev=0 }
        in_prod && /^\+[[:space:]]+[a-z_]+:/ { print; exit }')
    [[ -z "$NEW_DEPS" ]] || warn "60" "production dep חדש: $NEW_DEPS"; ran 60
}

