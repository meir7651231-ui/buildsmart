    NEW_DEPS=$(git diff --cached pubspec.yaml 2>/dev/null | awk '
        /^[+-]dependencies:/ { in_prod=1; in_dev=0; next }
        /^[+-]dev_dependencies:/ { in_dev=1; in_prod=0; next }
        /^[+-][a-z]/ && !/^[+-][[:space:]]/ { in_prod=0; in_dev=0 }
        in_prod && /^\+[[:space:]]+[a-z_]+:/ { print; exit }')
    [[ -z "$NEW_DEPS" ]] || warn "60" "production dep חדש: $NEW_DEPS"; ran 60
}

