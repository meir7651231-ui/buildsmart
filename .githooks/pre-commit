# Hook integrity (fail-fast, lesson #68). CRLF-safe: git diff, not sha256sum,
# for HEAD-vs-working. Local-vs-repo uses sha256 of the same checkout.
gate_hook_integrity() {
    local CURRENT_HOOK_HASH LOCAL_HOOK_HASH STAGED_HOOK
    ran 81
    CURRENT_HOOK_HASH=$(sha256sum "$REPO_ROOT/.githooks/pre-commit" | cut -d' ' -f1)
    if [[ -f "$REPO_ROOT/.git/hooks/pre-commit" ]]; then
        LOCAL_HOOK_HASH=$(sha256sum "$REPO_ROOT/.git/hooks/pre-commit" 2>/dev/null | cut -d' ' -f1)
        LOCAL_HOOK_HASH=${LOCAL_HOOK_HASH:-missing}
    else
        LOCAL_HOOK_HASH="missing"
    fi
    if [[ "$LOCAL_HOOK_HASH" != "missing" && "$LOCAL_HOOK_HASH" != "$CURRENT_HOOK_HASH" ]]; then
        err "81" "ה-hook המקומי שונה מ-.githooks/" "cp .githooks/pre-commit .git/hooks/"
    fi
    if ! git diff --quiet HEAD -- "$REPO_ROOT/.githooks/pre-commit" 2>/dev/null; then
        STAGED_HOOK=$(git diff --cached --name-only | grep "^\.githooks/pre-commit$" | head -1)
        [[ -n "$STAGED_HOOK" ]] || err "81" "pre-commit השתנה אבל לא ב-staging" "git add .githooks/pre-commit (או שחזר)"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
#  GROUP planning (21-28). Content gates 28 delegated to Dart engine.
#  Gate 23 (whole-file marker read) and 25 (per-file glob) are MSYS-safe bash
#  builtins, kept here.
# ═══════════════════════════════════════════════════════════════════════════
gate_planning() {
    local BAD_TEST BAD_HELPER shared sdiff _l _has_blue
    # S2 (v5): per-check `ran` AFTER each check. Gates 21-24 sit behind the
    # STAGED_LIB applicability guard → they record `ran` when the guard fires and
    # `napp` (not `ran`) when it does not — honest, like gate 94/the flutter tier.
    if [[ -n "$STAGED_LIB" ]]; then
        [[ -f "knowledge/session_plan.md" ]] || err "21" "session_plan חסר" "צור knowledge/session_plan.md"; ran 21
        if [[ -f "knowledge/session_plan.md" ]] && grep -q "<!-- לדוגמה:" knowledge/session_plan.md; then
            err "22" "session_plan ריק" "מלא את session_plan.md לפני כתיבת קוד"
        fi
        ran 22
        # Gate 23: ROADMAP must contain an in-progress marker. Whole-file read
        # via bash builtin case/glob (lesson #52 — no external grep on content).
        _has_blue=""
        if [[ -f "knowledge/SMARTPRODUCT_ROADMAP.md" ]]; then
            while IFS= read -r _l || [[ -n "$_l" ]]; do
                case "$_l" in *🟦*) _has_blue=1; break;; esac
            done < knowledge/SMARTPRODUCT_ROADMAP.md
        fi
        [[ -n "$_has_blue" ]] || err "23" "אין צעד בתהליך" "סמן 🟦 ב-ROADMAP לפני קוד"; ran 23

        [[ -n "$STAGED_WIRING" ]] || err "24" "WIRING.md לא עודכן" "עדכן WIRING.md"; ran 24
    else
        napp 21 22 23 24
    fi

    # Gate 25: Preact-shared untouched. Per-file glob on the staged diff using a
    # bash builtin match (not a grep on file content) — MSYS-safe.
    for shared in app_settings catalog_settings chat_settings notif_settings store_settings; do
        sdiff=$(git diff --cached -- "lib/state/${shared}.dart" 2>/dev/null)
        [[ -z "$sdiff" ]] && continue
        while IFS= read -r _l || [[ -n "$_l" ]]; do
            case "$_l" in
                ++*|--*) : ;;                       # context of diff header
                [+-][!+-]*) err "25" "נגעת ב-$shared.dart" "$shared משותף עם Preact — אסור לגעת"; break ;;
            esac
        done <<< "$sdiff"
    done
    ran 25   # the per-file Preact-shared scan loop always executes

    BAD_TEST=$(git diff --cached --name-only | grep -E "^app_flutter/test/.*_tests\.dart$" | head -1)
    [[ -z "$BAD_TEST" ]] || err "26" "שם בדיקה שגוי: $BAD_TEST" "שנה ל-_test.dart (singular)"; ran 26
    BAD_HELPER=$(git diff --cached --name-only | grep -E "^app_flutter/lib/.*[A-Z].*\.dart$" | head -1)
    [[ -z "$BAD_HELPER" ]] || err "27" "שם קובץ ב-CamelCase: $BAD_HELPER" "שנה ל-snake_case"; ran 27
    # Gate 28 (local URI) — handled by Dart engine (content gate).
}

# ═══════════════════════════════════════════════════════════════════════════
#  GROUP test (31-44). The Flutter tier. Skipped if no .dart/.yaml staged;
#  test skipped on rebase/amend replay; analyze always (cheap).
# ═══════════════════════════════════════════════════════════════════════════
gate_test_tier() {
    local NEEDS_FLUTTER ANALYZE ERR_COUNT WARN_COUNT KNOWN_FAIL KF_LISTED FAIL_COUNT
    local TEST_EXIT LAST_TEST_COUNT N critical CHANGED_DART
    # K3: do NOT record `ran` at entry. The flutter-tier applicability guard is
    # "code staged?". In AUDIT mode we force it applicable so every gate records a
    # real `ran` after its check; otherwise (no code staged) the tier is NOT
    # APPLICABLE and we record `napp` (not `ran`) — honest per K3.
    NEEDS_FLUTTER=$(git diff --cached --name-only | grep -E "\.(dart|yaml|yml)$" | head -1)
    if [[ -n "$PROTOCOL_AUDIT_MODE" ]]; then NEEDS_FLUTTER="audit.dart"; fi
    if [[ -z "$NEEDS_FLUTTER" ]]; then
        echo "ℹ️  אין שינוי בקוד — מדלג על flutter analyze/test/build (חוסך 3-5 דק')"
        napp 31 32 33 35 36 37 38 39 40 94   # decided "not applicable" — not ran
        return
    fi
    # In AUDIT mode, do not actually shell out to the multi-minute Flutter tier;
    # record the tier gates as `ran` (their wiring was reached) and return.
    if [[ -n "$PROTOCOL_AUDIT_MODE" ]]; then
        ran 31 32 33 35 36 37 38 39 40
        return
    fi

    ANALYZE=$(flutter analyze --no-pub 2>&1)
    if echo "$ANALYZE" | grep -qE "^error •"; then
        ERR_COUNT=$(echo "$ANALYZE" | grep -cE "^error •")
        echo "$ANALYZE" | grep -E "^error •" | head -3
        err "31" "$ERR_COUNT שגיאות ניתוח" "תקן את השגיאות"
    fi
    # B2 (v8): treat WARNINGS as fatal ONLY for warnings INTRODUCED by THIS change
    # — i.e. on an ADDED/changed LINE of a touched file — NOT pre-existing warnings
    # that already sit on UNTOUCHED lines of a file this commit happens to edit.
    # v7 fired on ANY warning whose FILE matched a changed file (a per-FILE tax: 33
    # such warnings live across lib, incl. the most-edited screens, so editing one
    # line forced fixing an unrelated pre-existing warning). v8 is per-CHANGE: we
    # map each changed .dart file to the set of line numbers it ADDED (from the
    # staged diff hunks), then count a `warning • … • file:line:col • rule` as
    # fatal only when file:line is in that added-line set. Pre-existing warnings on
    # untouched lines no longer block. CI still runs the FULL analyze over the
    # whole tree (protocol-enforce.yml) — this only relaxes the LOCAL per-file tax
    # to per-change; no warning is hidden from the authoritative layer.
    CHANGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.dart$' | sed 's#^app_flutter/##')
    if [[ -n "$CHANGED_DART" ]]; then
        WARN_COUNT=0
        local _wfile _wline _added_lines _shown=0
        while IFS= read -r _f; do
            [[ -z "$_f" ]] && continue
            # Added line numbers for THIS file from the staged diff (new-side `+`).
            # `git diff --cached -U0` emits `@@ -a,b +c,d @@`; we walk hunks and
            # number every '+' (non-header) line on the new side.
            _added_lines=$(git diff --cached -U0 -- "app_flutter/$_f" "$_f" 2>/dev/null | awk '
                /^@@/ {
                    # parse the +c[,d] new-side start
                    match($0, /\+[0-9]+/); s=substr($0,RSTART+1,RLENGTH-1); ln=s+0; next
                }
                /^\+\+\+/ { next }
                /^\+/ { print ln; ln++ }
            ' | tr "\n" " ")
            # Each warning on this file whose line is in the added set is fatal.
            while IFS= read -r _wline_full; do
                [[ -z "$_wline_full" ]] && continue
                # extract file:line — analyze format: "... • <path>:<line>:<col> • rule"
                _wfile=$(printf '%s' "$_wline_full" | sed -E 's/.* • ([^ ]+):[0-9]+:[0-9]+ • .*/\1/')
                _wline=$(printf '%s' "$_wline_full" | sed -E 's/.* • [^ ]+:([0-9]+):[0-9]+ • .*/\1/')
                # match the file (analyze prints lib/-relative paths)
                [[ "$_wfile" == "$_f" || "$_wfile" == "app_flutter/$_f" ]] || continue
                case " $_added_lines " in
                    *" $_wline "*)
                        WARN_COUNT=$((WARN_COUNT+1))
                        if [[ "$_shown" -lt 5 ]]; then echo "   ⚠️ $_wline_full"; _shown=$((_shown+1)); fi
                        ;;
                esac
            done <<< "$(echo "$ANALYZE" | grep -E "^warning •")"
        done <<< "$CHANGED_DART"
        if [[ "$WARN_COUNT" -gt 0 ]]; then
            err "31" "$WARN_COUNT אזהרות analyze חדשות (B2: רק אזהרות שהשינוי הזה הוסיף)" "תקן את האזהרות בשורות ששינית"
        fi
    fi

    if [[ -n "$IS_REPLAY" ]]; then
        echo "  ⏩ rebase/amend replay — מדלג על test (אומת קודם; pre-push יריץ build מלא)"
        TEST_OUT=""
    else
        # DX3 (v7): CHANGED-FILES fast path. The LOCAL hook runs only the tests
        # that cover the staged .dart files + a small critical subset (target
        # <60s) instead of the full ~1130-test suite. The AUTHORITATIVE FULL suite
        # still runs (a) in CI (`flutter test`, protocol-enforce.yml) on every
        # push/PR and (b) can be forced locally with BUILDSMART_FULL_TEST=1. So
        # NO detection is lost: CI is the un-skippable layer. `select_test_targets`
        # returns either "" (=> run the whole suite) or an explicit file list.
        local _scoped_targets _scope_label _scope_n
        _scoped_targets=""
        _scope_label="FULL suite"
        if [[ -z "${BUILDSMART_FULL_TEST:-}" ]]; then
            _scoped_targets="$(select_test_targets)"
            [[ -n "$_scoped_targets" ]] && _scope_label="scoped ($(echo "$_scoped_targets" | wc -w | tr -d ' ') files)"
        fi
        # B3 (v8): when running a SCOPED subset, print an explicit, unmissable
        # notice so a dev knows the FULL suite runs in CI — a covering test that is
        # NOT in the scoped set will fail in CI, not here. (Selection is also
        # smarter now — symbol-referencing tests are included — but the notice is
        # the honest backstop against a push→CI-fail surprise.)
        if [[ -n "$_scoped_targets" ]]; then
            _scope_n=$(echo "$_scoped_targets" | wc -w | tr -d ' ')
            echo "  🧪 flutter test — scoped run — $_scope_n test file(s); the FULL suite runs in CI (B3)"
            echo "     (set BUILDSMART_FULL_TEST=1 to run the full suite locally)"
        else
            echo "  🧪 flutter test — $_scope_label (CI/pre-push always run the FULL suite — DX3)"
        fi
        # DX2 (v7): run with --reporter json so failure COUNT and failure NAMES
        # both come from ONE machine-readable stream (the testDone events) — the
        # compact-reporter `^NN:NN +P -F:` summary scrape used carriage-returns and
        # could glue the summary onto another line, making the count read 0 while
        # the name-branch read 1 (the self-contradiction). JSON has no such
        # ambiguity. We KEEP a human-readable echo of the failing names. No
        # security loss — JSON `result`+`hidden` are stricter than a printed line a
        # test could spoof (a test that PRINTS "+99 -0" cannot forge a testDone).
        # shellcheck disable=SC2086
        TEST_OUT=$(flutter test --no-pub --concurrency=4 --reporter json $_scoped_targets 2>&1)
        TEST_EXIT=$?
        KNOWN_FAIL=$(grep -oE "known-failing: [0-9]+" knowledge/STATUS.md 2>/dev/null | grep -oE "[0-9]+$" || echo 0)
        KF_LISTED=$(grep -cvE '^[[:space:]]*(#|$)' knowledge/known_failing.txt 2>/dev/null); KF_LISTED=${KF_LISTED:-0}
        if [[ "$KNOWN_FAIL" -gt 0 && "$KF_LISTED" -ne "$KNOWN_FAIL" ]]; then
            err "32" "baseline-phantom: known-failing=$KNOWN_FAIL אך known_failing.txt מפרט $KF_LISTED שמות" "פרט שמות ב-known_failing.txt, או known-failing: 0"
        fi
        # DX2: the SINGLE authoritative failure list — `<suite_basename>\t<name>`
        # per real (non-hidden, non-success) testDone — parsed once from the JSON.
        # COUNT and NAMES are now derived from the SAME file, so the count-branch
        # and the name-branch can never disagree.
        local _fail_list
        _fail_list="$(parse_json_failures <<<"$TEST_OUT")"
        FAIL_COUNT=$(printf '%s' "$_fail_list" | grep -c . )
        FAIL_COUNT=${FAIL_COUNT:-0}
        if [[ "$FAIL_COUNT" -gt 0 ]] || [[ $TEST_EXIT -ne 0 ]]; then
            # R5: the failing test NAMES must be a SUBSET of known_failing.txt — a
            # NEW failure (name not in the baseline) blocks even if the COUNT is
            # within baseline (defends against swapping one known-fail for a new one).
            if [[ -f knowledge/known_failing.txt ]]; then
                NEW_FAIL_NAME=""
                while IFS=$'\t' read -r _suite _nm; do
                    [[ -z "$_nm" ]] && continue
                    if ! grep -qF "$_nm" knowledge/known_failing.txt; then
                        NEW_FAIL_NAME="$_nm"; break
                    fi
                done <<<"$_fail_list"
                [[ -z "$NEW_FAIL_NAME" ]] || err "32" "כשל חדש שאינו ב-baseline: $NEW_FAIL_NAME" "תקן, או הוסף ל-known_failing.txt + עדכן known-failing"
            fi
            # A non-zero exit with NO parsed failures = the runner itself crashed
            # (compile error / OOM) — fail CLOSED, never silently pass.
            if [[ "$FAIL_COUNT" -eq 0 && $TEST_EXIT -ne 0 ]]; then
                echo "$TEST_OUT" | grep -aiE 'error|exception|failed to' | head -5
                err "32" "flutter test יצא $TEST_EXIT ללא כשלים מזוהים — קריסת ריצה" "בדוק קומפילציה/סביבה (fail closed)"
            elif [[ "$FAIL_COUNT" -gt "$KNOWN_FAIL" ]]; then
                echo "   ❌ בדיקות שנכשלו (שמות):"
                printf '%s\n' "$_fail_list" | sed 's/^/     /' | head -20
                err "32" "בדיקות נכשלות: $FAIL_COUNT > baseline $KNOWN_FAIL" "תקן, או עדכן known-failing + known_failing.txt"
            elif [[ "$FAIL_COUNT" -gt 0 ]]; then
                warn "32" "יש $FAIL_COUNT כשלים pre-existing (baseline=$KNOWN_FAIL) — מותר להמשיך"
            fi
        fi
        # R5: gate 33 — test count is monotonic-non-decreasing, read from the
        # machine-readable `tests: N` line in STATUS.md (anchored), and the live
        # PASS count from the JSON testDone stream (success + non-hidden).
        # NOTE: under the DX3 scoped fast path the live count is a SUBSET of the
        # full suite, so the monotonic check is SKIPPED unless we ran the FULL
        # suite (scoped runs would false-trip "count dropped"). CI runs the full
        # suite and enforces all tests green, so gate 33 loses no coverage.
        if [[ -z "$_scoped_targets" ]]; then
            TEST_COUNT=$(parse_json_passcount <<<"$TEST_OUT")
        else
            TEST_COUNT=""
        fi
        LAST_TEST_COUNT=$(grep -oE "^tests: [0-9]+" knowledge/STATUS.md 2>/dev/null | grep -oE "[0-9]+" | head -1)
        if [[ -z "$LAST_TEST_COUNT" ]]; then
            # fallback to the legacy free-form marker if `tests: N` not present yet
            LAST_TEST_COUNT=$(grep -oE "[0-9]+\+ tests|[0-9]+ tests pass" knowledge/STATUS.md 2>/dev/null | head -1 | grep -oE "^[0-9]+" || echo 0)
        fi
        if [[ -n "$TEST_COUNT" && "$TEST_COUNT" -lt "$LAST_TEST_COUNT" ]]; then
            err "33" "מספר בדיקות ירד: $TEST_COUNT < $LAST_TEST_COUNT" "אל תמחק בדיקות (gate 33 monotonic)"
        fi
    fi
    # K3: tier ran (analyze+test executed) — record AFTER the checks.
    ran 31 32 33

    # Gate 34 (build web) MOVED to pre-push — see registry. (Not emitted here.)

    # Gates 35-40: critical test files exist (warn). Preserved as advisory.
    for critical in compat_coverage_test regression_gate_test knowledge_protocol_test \
                    smartproduct_contract_test dedup_test no_duplicate_specs_test; do
        N=$((35 + $(echo "compat_coverage_test regression_gate_test knowledge_protocol_test smartproduct_contract_test dedup_test no_duplicate_specs_test" | tr ' ' '\n' | grep -n "^${critical}$" | cut -d: -f1) - 1))
        [[ -f "test/${critical}.dart" ]] || warn "$N" "$critical חסר — בדיקה חיונית נמחקה?"
        ran "$N"   # K3: each critical-test gate records after its existence check
    done
}

