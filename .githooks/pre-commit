#!/bin/bash
# פרוטוקול BuildSmart — 100 שערים אוטומטיים
# נשמר בריפו ב-.githooks/ — חל על כל מודל וכל clone
# כל הפרת פרוטוקול = חסימה מוחלטת

# M7: paths דינמיים — מחפש flutter על Linux / macOS (Intel+ARM) / Windows Git Bash
for candidate in \
    "/home/user/flutter/bin" \
    "/c/flutter/bin" \
    "$HOME/flutter/bin" \
    "/usr/local/flutter/bin" \
    "/opt/homebrew/opt/flutter/bin" \
    "/opt/flutter/bin"; do
    [[ -d "$candidate" ]] && PATH="$candidate:$PATH"
done
export PATH

# וודא ש-flutter זמין; אם לא — שגיאה ברורה
if ! command -v flutter >/dev/null 2>&1; then
    echo "❌ flutter לא נמצא ב-PATH" >&2
    echo "   הוסף flutter/bin ל-PATH או התקן Flutter" >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# M4: emergency disable — לשימוש בעת באג קריטי בפרוטוקול בלבד
# הפעלה: export BUILDSMART_EMERGENCY_DISABLE="$(cat .emergency_token)"
if [[ -n "${BUILDSMART_EMERGENCY_DISABLE:-}" ]]; then
    TOKEN_FILE="$REPO_ROOT/.emergency_token"
    if [[ -f "$TOKEN_FILE" ]]; then
        EXPECTED=$(tr -d '[:space:]' < "$TOKEN_FILE")
        GIVEN=$(echo "${BUILDSMART_EMERGENCY_DISABLE}" | tr -d '[:space:]')
        if [[ ${#EXPECTED} -ge 16 && "$GIVEN" == "$EXPECTED" ]]; then
            echo "⚠️  EMERGENCY DISABLE פעיל — פרוטוקול מושהה. רשום ב-stuck_log." >&2
            echo "[$(date -Iseconds)] EMERGENCY_DISABLE used — pre-commit bypassed" \
                >> "$REPO_ROOT/.git/protocol_audit.log"
            exit 0
        fi
    fi
    echo "🔒 BUILDSMART_EMERGENCY_DISABLE לא תקין — token חסר/לא נכון." >&2
fi

cd "$REPO_ROOT/app_flutter" || exit 1

FAIL=0
WARN=0
FAILED_GATES=""   # מספרי השערים שנכשלו — לסיווג retry (code/test מול bookkeeping)
err()  { echo ""; echo "❌ [שער $1] $2"; echo "   → $3"; FAIL=$((FAIL+1)); FAILED_GATES="$FAILED_GATES,$1"; }
warn() { echo "⚠️  [שער $1] $2"; WARN=$((WARN+1)); }
ok()   { :; }  # שתיקה — רק כשלים נראים

# ═══ מנגנון למידה: זיהוי retry ═══
FINGERPRINT_FILE="$REPO_ROOT/.git/stuck_fingerprints.txt"
touch "$FINGERPRINT_FILE"

# חתימת הניסיון הנוכחי (שמות הקבצים ב-staging)
CURRENT_FP=$(git diff --cached --name-only | sort | sha256sum | cut -d' ' -f1 | head -c 12)
# תיקון #3 (אודיט 2026-06-01): גם HEAD — שינוי סט-הקבצים לא יתחמק מזיהוי retry.
# retry = ניסיון commit כש-HEAD לא זז מאז כשל (אי-אפשר להצליח commit עם שער נכשל,
# אז HEAD זז רק בהצלחה → אותו HEAD + כשל קודם = retry, לא משנה אילו קבצים).
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "none")
IS_RETRY="false"
PRIOR_GATES=""   # מספרי השערים שנכשלו בניסיון הקודם (לסיווג שער 102)
# אם חתימת-הקבצים או ה-HEAD הופיעו ב-5 השעות האחרונות → retry
NOW=$(date +%s)
FIVE_HOURS_AGO=$((NOW - 18000))
while IFS=' ' read -r fp ts rest; do
    [[ "$ts" -gt "$FIVE_HOURS_AGO" ]] || continue
    # חילוץ שדה gates= מהרשומה (רשימת שערים מופרדת בפסיקים, או count ברשומה ישנה)
    rec_gates="${rest#gates=}"; rec_gates="${rec_gates%% *}"
    # תואם-לאחור: רשומה ישנה בלי "head=" → rec_head=כל ה-rest, לא יתאים ל-sha
    rec_head="${rest##*head=}"
    if [[ "$fp" == "$CURRENT_FP" ]]; then
        IS_RETRY="true"; PRIOR_GATES="$rec_gates"; break
    fi
    if [[ "$HEAD_SHA" != "none" && "$rec_head" == "$HEAD_SHA" ]]; then
        IS_RETRY="true"; PRIOR_GATES="$rec_gates"; break
    fi
done < "$FINGERPRINT_FILE"

# סיווג: האם הכשל הקודם כלל שער code/test (31-45)? רק אז שער 102 דורש תיעוד.
# bookkeeping טהור (12 version / 24 WIRING / 59 path) → פטור: אין ANTIPATTERN
# משמעותי ל"שכחתי לבמפ version", וה-gate עצמו תופס אותם שוב ממילא.
# שער 42 (helper חדש בלי בדיקה) → פטור: הפתרון הוא הוספת בדיקה — אין ANTIPATTERN לתעד
# (לקח #64 — דווח ע"י בנצי, 2026-06-01)
# פורמט v2: `gates=v2:12,24` (רשימת מספרי-שערים). רשומה ישנה (`gates=<count>`)
# או לא-מזוהה → conservative: דורש תיעוד (כמו לפני התיקון).
PRIOR_HAS_CODE_TEST=""
if [[ "$PRIOR_GATES" == v2:* ]]; then
    prior_nums="${PRIOR_GATES#v2:}"
    for g in ${prior_nums//,/ }; do
        [[ "$g" =~ ^[0-9]+$ ]] && (( g >= 31 && g <= 45 )) && (( g != 42 )) && { PRIOR_HAS_CODE_TEST="1"; break; }
    done
elif [[ -n "$PRIOR_GATES" ]]; then
    PRIOR_HAS_CODE_TEST="1"   # פורמט ישן/לא-מזוהה → צד זהיר
fi

echo ""
echo "══════════════════════════════════════════════"
echo "  פרוטוקול BuildSmart — 100 שערים אוטומטיים"
echo "══════════════════════════════════════════════"

# ═══ קבוצה א: יסודות (1-10) ═══

# שער 1: ענף עבודה
BRANCH=$(git branch --show-current)
[[ "$BRANCH" == claude/* ]] || err "1" "ענף שגוי: $BRANCH" "עבור לענף claude/*"

# שער 2: 11 קבצי ידע קיימים
for f in README.md PLAYBOOK.md STATUS.md SMARTPRODUCT_ROADMAP.md SCHEMA.md \
         STATE_OVERVIEW.md TESTS_OVERVIEW.md HELPER_INDEX.md CARD_FLOW.md \
         AGENT_PATTERNS.md CATALOG-CARD-PROTOCOL.md; do
    [[ -f "knowledge/$f" ]] || err "2" "קובץ ידע חסר: $f" "צור knowledge/$f"
done

# שער 3: WIRING.md קיים
[[ -f "WIRING.md" ]] || err "3" "WIRING.md חסר" "צור app_flutter/WIRING.md"

# שער 4: pubspec.yaml תקין
[[ -f "pubspec.yaml" ]] || err "4" "pubspec.yaml חסר" "אתה בתיקייה הלא נכונה"

# שער 5: ענף שמעוקב
git rev-parse "origin/$BRANCH" >/dev/null 2>&1 || warn "5" "אין מעקב של $BRANCH ב-origin"

# שער 6-9: hooks קיימים בריפו
[[ -f "$REPO_ROOT/.githooks/pre-commit" ]] || err "6" "pre-commit חסר מהריפו" "שחזר את .githooks/pre-commit"
[[ -f "$REPO_ROOT/.githooks/pre-push" ]] || err "7" "pre-push חסר מהריפו" "שחזר את .githooks/pre-push"
[[ -f "$REPO_ROOT/.githooks/commit-msg" ]] || err "105" "commit-msg חסר" "שחזר את .githooks/commit-msg"
[[ -f "$REPO_ROOT/.claude/settings.json" ]] || err "8" "settings.json חסר" "שחזר את .claude/settings.json"
[[ -f "$REPO_ROOT/.claude/hooks/pre-tool.sh" ]] || err "9" "pre-tool.sh חסר" "שחזר את .claude/hooks/pre-tool.sh"

# שער 10: GitHub Actions קיים
[[ -f "$REPO_ROOT/.github/workflows/protocol-enforce.yml" ]] || err "10" "workflow חסר" "שחזר את GitHub Actions"

# ═══ קבוצה ב: מצב נוכחי (11-20) ═══

# שער 11-12: גרסאות מסונכרנות
V_SHELL=$(grep -oE "v[0-9]+\.[0-9]+" lib/screens/home_shell.dart 2>/dev/null | head -1)
V_STATUS=$(grep -oE "v[0-9]+\.[0-9]+" knowledge/STATUS.md 2>/dev/null | head -1)
[[ -n "$V_SHELL" ]] || err "11" "גרסה חסרה ב-home_shell.dart" "הוסף תווית גרסה"
[[ "$V_SHELL" == "$V_STATUS" ]] || err "12" "גרסאות לא מסונכרנות" "home_shell=$V_SHELL, STATUS=$V_STATUS"

# שער 13: ROADMAP מכיל קבוצה א'
grep -q "Group A" knowledge/SMARTPRODUCT_ROADMAP.md || err "13" "ROADMAP בלי קבוצה א'" "ROADMAP מקולקל"

# שער 14: STATUS מכיל גרסה
[[ -n "$V_STATUS" ]] || err "14" "גרסה חסרה ב-STATUS.md" "הוסף תווית גרסה"

# שער 15-17: hooks אקטיביים
HOOK_PATH=$(git config --get core.hooksPath)
[[ "$HOOK_PATH" == ".githooks" ]] || err "15" "hooks לא מופעלים מהריפו" "git config core.hooksPath .githooks"
[[ -x "$REPO_ROOT/.githooks/pre-commit" ]] || err "16" "pre-commit לא executable" "chmod +x .githooks/pre-commit"
[[ -x "$REPO_ROOT/.githooks/pre-push" ]] || err "17" "pre-push לא executable" "chmod +x .githooks/pre-push"

# שער 18-20: knowledge/ נגיש
[[ -d "knowledge" ]] || err "18" "תיקיית knowledge חסרה" "צור knowledge/"
[[ -d "lib/state" ]] || err "19" "תיקיית lib/state חסרה" "מבנה הפרויקט פגום"
[[ -d "test" ]] || err "20" "תיקיית test חסרה" "מבנה הפרויקט פגום"

# ═══ קבוצה ג: תכנון (21-30) ═══

STAGED_LIB=$(git diff --cached --name-only | grep -E "^app_flutter/lib/(screens|state|logic)/" | head -1)
STAGED_HELPER=$(git diff --cached --name-only | grep -E "^app_flutter/lib/(logic|data)/" | head -1)
STAGED_TEST=$(git diff --cached --name-only | grep -E "^app_flutter/test/.*_test\.dart$" | head -1)
STAGED_KNOWLEDGE=$(git diff --cached --name-only | grep "knowledge/" | head -1)

if [[ -n "$STAGED_LIB" ]]; then
    # שער 21: session_plan קיים
    [[ -f "knowledge/session_plan.md" ]] || err "21" "session_plan חסר" "צור knowledge/session_plan.md"

    # שער 22: session_plan לא ריק (לא template)
    if [[ -f "knowledge/session_plan.md" ]] && grep -q "<!-- לדוגמה:" knowledge/session_plan.md; then
        err "22" "session_plan ריק" "מלא את session_plan.md לפני כתיבת קוד"
    fi

    # שער 23: יש צעד 🟦 ב-ROADMAP
    # תיקון אודיט 2026-06-01 (לקח #52, אותו class כמו 103): אפילו `grep -aqF` נכשל
    # תחת invocation של git-for-windows — git מחליף את ה-grep binary/PATH, כך
    # שהבדיקה עוברת standalone אך נכשלת תחת `git commit`. bash case/glob הוא
    # builtin טהור (אפס binary חיצוני) → byte-match עקבי בכל סביבה.
    _has_blue=""
    if [[ -f "knowledge/SMARTPRODUCT_ROADMAP.md" ]]; then
        while IFS= read -r _l || [[ -n "$_l" ]]; do
            case "$_l" in *🟦*) _has_blue=1; break;; esac
        done < knowledge/SMARTPRODUCT_ROADMAP.md
    fi
    [[ -n "$_has_blue" ]] || err "23" "אין צעד בתהליך" "סמן 🟦 ב-ROADMAP לפני קוד"

    # שער 24: WIRING.md עודכן
    STAGED_WIRING=$(git diff --cached --name-only | grep "WIRING.md" | head -1)
    [[ -n "$STAGED_WIRING" ]] || err "24" "WIRING.md לא עודכן" "עדכן WIRING.md"
fi

# שער 25: לא לגעת ב-Preact-shared
for shared in app_settings catalog_settings chat_settings notif_settings store_settings; do
    if git diff --cached lib/state/${shared}.dart 2>/dev/null | grep -q "^[+-][^+-]"; then
        err "25" "נגעת ב-$shared.dart" "$shared משותף עם Preact — אסור לגעת"
    fi
done

# שער 26-28: שמות קבצים תקינים (תיקון באג #14 — רק ב-test/ בלבד)
BAD_TEST=$(git diff --cached --name-only | grep -E "^app_flutter/test/.*_tests\.dart$" | head -1)
[[ -z "$BAD_TEST" ]] || err "26" "שם בדיקה שגוי: $BAD_TEST" "שנה ל-_test.dart (singular)"

BAD_HELPER=$(git diff --cached --name-only | grep -E "^app_flutter/lib/.*[A-Z].*\.dart$" | head -1)
[[ -z "$BAD_HELPER" ]] || err "27" "שם קובץ ב-CamelCase: $BAD_HELPER" "שנה ל-snake_case"

# שער 28-30: אין URI מקומי (רק בקוד dart, לא בhook עצמו)
BAD_URI=$(git diff --cached -- '*.dart' ':(exclude)*stuck_regression_test.dart' 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "file:///|C:\\\\" | head -1)
[[ -z "$BAD_URI" ]] || err "28" "URI מקומי בקוד" "הסר נתיב מוחלט"

# ═══ קבוצה ד: בדיקה (31-45) ═══

# תיקון באג #19: tiered execution
# אם אין שינוי dart/yaml — מדלגים על flutter analyze/test/build (חוסך 3-5 דק' לcommits של תיעוד)
NEEDS_FLUTTER=$(git diff --cached --name-only | grep -E "\.(dart|yaml|yml)$" | head -1)
if [[ -n "$NEEDS_FLUTTER" ]]; then
    # שער 31: ניתוח קוד — שגיאות בלבד
    ANALYZE=$(flutter analyze --no-pub 2>&1)
    if echo "$ANALYZE" | grep -qE "^error •"; then
        ERR_COUNT=$(echo "$ANALYZE" | grep -cE "^error •")
        echo "$ANALYZE" | grep -E "^error •" | head -3
        err "31" "$ERR_COUNT שגיאות ניתוח" "תקן את השגיאות"
    fi

    # שער 32: בדיקות לא נכשלות מעבר ל-baseline (תיקון באג #19 — baseline tracking)
    # baseline מאוחסן ב-STATUS.md: "known-failing: N" — מאפשר pre-existing failures
    TEST_OUT=$(flutter test --no-pub 2>&1)
    TEST_EXIT=$?
    KNOWN_FAIL=$(grep -oE "known-failing: [0-9]+" knowledge/STATUS.md 2>/dev/null | grep -oE "[0-9]+$" || echo 0)
    # מניעת baseline-phantom (אודיט 2026-06-01): known-failing > 0 חייב רשימת שמות
    # תואמת ב-known_failing.txt — אחרת אפשר להגדיר baseline מדומה ש"בולע" רגרסיות
    # אמיתיות בשקט. לקח #27: grep -c → ${var:-0}, לא "|| echo 0".
    KF_LISTED=$(grep -cvE '^[[:space:]]*(#|$)' knowledge/known_failing.txt 2>/dev/null); KF_LISTED=${KF_LISTED:-0}
    if [[ "$KNOWN_FAIL" -gt 0 && "$KF_LISTED" -ne "$KNOWN_FAIL" ]]; then
        err "32" "baseline-phantom: known-failing=$KNOWN_FAIL אך known_failing.txt מפרט $KF_LISTED שמות" "פרט את שמות הבדיקות ב-known_failing.txt, או הגדר known-failing: 0"
    fi
    if [[ $TEST_EXIT -ne 0 ]] || echo "$TEST_OUT" | grep -qE "Some tests failed"; then
        # flutter compact output: "XX:XX +888 -16: Some tests failed." — חלץ את -N
        # תיקון באג #32: pattern הקודם "[0-9]+ ✗" לא מוצא דבר ב-compact mode
        FAIL_COUNT=$(echo "$TEST_OUT" | grep -oE "\+[0-9]+ -[0-9]+:" | grep -oE -- "-[0-9]+" | grep -oE "[0-9]+" | tail -1)
        FAIL_COUNT=${FAIL_COUNT:-0}
        if [[ "$FAIL_COUNT" -gt "$KNOWN_FAIL" ]]; then
            # הדפס אילו בדיקות נכשלו בשמן — שהסוכן לא ייתקע "לא יודע מה נכשל"
            echo "   ❌ בדיקות שנכשלו (שמות):"
            echo "$TEST_OUT" | grep -aE "\[E\]|✗|FAILED|: .+ \[E\]" | head -20
            err "32" "בדיקות נכשלות: $FAIL_COUNT > baseline $KNOWN_FAIL" "תקן, או עדכן known-failing ב-STATUS.md + שמות ב-known_failing.txt"
        else
            warn "32" "יש $FAIL_COUNT כשלים pre-existing (baseline=$KNOWN_FAIL) — מותר להמשיך"
        fi
    fi

    TEST_COUNT=$(echo "$TEST_OUT" | grep -oE "\+[0-9]+" | tail -1 | tr -d '+')

    # שער 33: מספר בדיקות לא יורד (תיקון באג #10 — pattern נכון)
    LAST_TEST_COUNT=$(grep -oE "[0-9]+\+ tests|[0-9]+ tests pass" knowledge/STATUS.md 2>/dev/null | head -1 | grep -oE "^[0-9]+" || echo 0)
    if [[ -n "$TEST_COUNT" && "$TEST_COUNT" -lt "$LAST_TEST_COUNT" ]]; then
        err "33" "מספר בדיקות ירד: $TEST_COUNT < $LAST_TEST_COUNT" "אל תמחק בדיקות"
    fi

    # שער 34: בנייה לאינטרנט
    BUILD_OUT=$(flutter build web --release --no-pub 2>&1)
    if echo "$BUILD_OUT" | grep -qE "^Error|Failed to"; then
        err "34" "בנייה נכשלה" "תקן שגיאות בנייה"
    fi

    # שערים 35-40: קבצי בדיקה חיוניים קיימים (לא נמחקו).
    # תיקון לקח #55 (דיווח Finder): הצורה הישנה (`grep -q "$critical" $TEST_OUT`)
    # הסתמכה על כך ש-default-reporter מדפיס את שם כל קובץ — אבל כשהפלט נלכד
    # (לא-TTY) זה לא-דטרמיניסטי: 3/6 שמות חסרים בכל ריצה → warn שגוי קבוע.
    # גרוע מכך — הבדיקה הישנה דילגה לגמרי כשהקובץ *נמחק* (הסיכון האמיתי).
    # הנכון: warn אם הקובץ החיוני חסר. מעבר/כשל מכוסה ע"י שער 32 (FAIL_COUNT).
    for critical in compat_coverage_test regression_gate_test knowledge_protocol_test \
                    smartproduct_contract_test dedup_test no_duplicate_specs_test; do
        N=$((35 + $(echo "compat_coverage_test regression_gate_test knowledge_protocol_test smartproduct_contract_test dedup_test no_duplicate_specs_test" | tr ' ' '\n' | grep -n "^${critical}$" | cut -d: -f1) - 1))
        [[ -f "test/${critical}.dart" ]] || warn "$N" "$critical חסר — בדיקה חיונית נמחקה?"
    done
else
    echo "ℹ️  אין שינוי בקוד — מדלג על flutter analyze/test/build (חוסך 3-5 דק')"
fi

# שער 41: אין בדיקות עם count > 0
BAD_COUNT=$(git diff --cached test/ 2>/dev/null | grep "^+" | grep -E "greaterThan\(0\)" | head -1)
[[ -z "$BAD_COUNT" ]] || warn "41" "test עם greaterThan(0) — שביר על נתונים ריקים"

# שער 42: בדיקות חדשות בקובץ עם _test.dart
if [[ -n "$STAGED_HELPER" && -z "$STAGED_TEST" ]]; then
    err "42" "helper חדש בלי בדיקה" "צור test/*_test.dart לפונקציה החדשה"
fi

# שער 43-45: mutation log
if [[ -n "$STAGED_HELPER" ]]; then
    [[ -f "knowledge/mutation_log.md" ]] || err "43" "mutation_log חסר" "צור knowledge/mutation_log.md"
    if [[ -f "knowledge/mutation_log.md" ]]; then
        STAGED_MUT=$(git diff --cached --name-only | grep "mutation_log.md" | head -1)
        [[ -n "$STAGED_MUT" ]] || err "44" "mutation_log לא עודכן" "תעד הזרקת תקלה ב-mutation_log.md"
    fi
fi

# ═══ קבוצה ה: איכות קוד (46-60) ═══

# שער 46: אין משטחים כהים
DARK=$(git diff --cached lib/screens/ 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "0xFF111111|BsTokens\.bgDark" | head -1)
[[ -z "$DARK" ]] || err "46" "משטח כהה" "הסר 0xFF111111/BsTokens.bgDark"

# שער 47: אין dialog/sheet/route חדש בלי אישור
NEW_DIALOG=$(git diff --cached lib/screens/ 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "showDialog|showModalBottomSheet" | head -1)
if [[ -n "$NEW_DIALOG" && -z "$STAGED_WIRING" ]]; then
    warn "47" "dialog/sheet חדש — וודא שמופיע ב-WIRING"
fi

# שער 48: אין print() בproduction (תיקון באג #15 — pattern רחב יותר)
# תופס: ^print(, "  print(", " print(", "} print(", "; print("
