# ═══════════════════════════════════════════════════════════════════════════
gate_learning() {
    local STAGED_STUCK NEW_LINES STAGED_STUCK_LOG AP_COUNT RT_COUNT DUP_AP
    # S2 (v5): per-check `ran`/`napp` (103 -> engine). 101 always runs; 102/104/111
    # sit behind applicability guards → `ran` when reached, `napp` otherwise.
    [[ -f "$STUCK_LOG" ]] || err "101" "stuck_log.md חסר" "צור knowledge/stuck_log.md"; ran 101

    if [[ "$IS_RETRY" == "true" && -n "$PRIOR_HAS_CODE_TEST" && -f "$STUCK_LOG" ]]; then
        STAGED_STUCK=$(git diff --cached --name-only | grep "stuck_log.md" | head -1)
        if [[ -z "$STAGED_STUCK" ]]; then
            err "102" "פתרת בעיה — לא תיעדת" "עדכן knowledge/stuck_log.md: בעיה + פתרון + ANTIPATTERN + RULE"
        else
            NEW_LINES=$(git diff --cached "$STUCK_LOG" 2>/dev/null | grep "^+" | grep -v "^+++")
            if ! echo "$NEW_LINES" | grep -qE "^\+ANTIPATTERN(\[hook\])?:"; then
                err "102" "רשומה חסרה ANTIPATTERN" "הוסף שורת ANTIPATTERN: regex (בלי -EXAMPLE)"
            fi
            if ! echo "$NEW_LINES" | grep -qE "^\+RULE:"; then
                err "102" "רשומה חסרה RULE" "הוסף שורת RULE: כלל בעברית (בלי -EXAMPLE)"
            fi
        fi
        ran 102
    else
        napp 102
    fi

    # Gate 103 (antipattern recurrence) -> Dart engine (run_content_engine).

    # Gate 104: regenerate stuck_regression_test when stuck_log staged.
    STAGED_STUCK_LOG=$(git diff --cached --name-only | grep "stuck_log.md" | head -1)
    if [[ -n "$STAGED_STUCK_LOG" ]]; then
        bash "$REPO_ROOT/app_flutter/scripts/generate_stuck_regression.sh" >/dev/null 2>&1
        if ! git diff --quiet test/stuck_regression_test.dart 2>/dev/null; then
            git add test/stuck_regression_test.dart
            echo "🔁 stuck_regression_test.dart התעדכן אוטומטית"
        fi
        ran 104
    else
        napp 104
    fi

    # Gate 111: stuck_regression consistency (cheap, always).
    if [[ -f "knowledge/stuck_log.md" && -f "test/stuck_regression_test.dart" ]]; then
        AP_COUNT=$(grep -cE '^ANTIPATTERN(\[hook\])?:' knowledge/stuck_log.md); AP_COUNT=${AP_COUNT:-0}
        RT_COUNT=$(grep -cE 'test\("antipattern #' test/stuck_regression_test.dart); RT_COUNT=${RT_COUNT:-0}
        DUP_AP=$(grep -oE 'antipattern #[0-9]+' test/stuck_regression_test.dart | sort | uniq -d | head -1)
        [[ "$AP_COUNT" == "$RT_COUNT" ]] || err "111" "stuck_regression לא מסונכרן ($AP_COUNT ANTIPATTERN ≠ $RT_COUNT tests)" "הרץ scripts/generate_stuck_regression.sh"
        [[ -z "$DUP_AP" ]] || err "111" "מספור כפול ב-stuck_regression: $DUP_AP" "הרץ scripts/generate_stuck_regression.sh"
        # R5: BYTE-DIFF the regenerated test against the committed one. A manual
        # edit (e.g. deleting an antipattern test while keeping the count) is
        # caught — the generator is the single source of truth. Tamper-evident.
        local _regen
        _regen=$(mktemp 2>/dev/null)
        if [[ -n "$_regen" ]]; then
            if ( cd "$REPO_ROOT/app_flutter" \
                 && STUCK_REGEN_OUT="$_regen" bash "$REPO_ROOT/app_flutter/scripts/generate_stuck_regression.sh" >/dev/null 2>&1 ) \
               && [[ -s "$_regen" ]]; then
                if ! diff -q "$_regen" test/stuck_regression_test.dart >/dev/null 2>&1; then
                    err "111" "stuck_regression_test.dart נערך ידנית (byte-diff מול הגנרטור)" "הרץ scripts/generate_stuck_regression.sh ואל תערוך ידנית"
                fi
            fi
            rm -f "$_regen"
        fi
        # R5: monotonic-non-decreasing antipattern count vs the recorded baseline.
        local _ap_base
        _ap_base=$(grep -oE '^antipatterns: [0-9]+' knowledge/STATUS.md 2>/dev/null | grep -oE '[0-9]+' | head -1)
        if [[ -n "$_ap_base" && "$AP_COUNT" -lt "$_ap_base" ]]; then
            err "111" "מספר אנטי-פטרנים ירד: $AP_COUNT < baseline $_ap_base" "אנטי-פטרנים נצברים בלבד — אל תמחק לקחים"
        fi
        ran 111
    else
        napp 111
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
#  GROUP knowledge (106-116 cheap). Content gate 114 -> engine.
# ═══════════════════════════════════════════════════════════════════════════
gate_knowledge() {
    local stub sf SLN DONE_COUNT PENDING STAGED_CF AUDIT_LINES STAGED_CROP STAGED_CARRY
    local CLAIMS_FILE STAGED_NAMES STAGED_UI STAGED_UI2 STAGED_VLOG _l _in_claims _cpath
    # S2 (v5): per-check `ran` AFTER each gate's detection runs (114 -> engine).
    # The detection logic (the VAR=$(...) + guard) always executes structurally;
    # `ran` after the block is exec-proof — deleting the block drops its `ran`.

    # Gate 112: unified stubs.
    for stub in TESTING CHECKLISTS BUG_INVESTIGATION_PROTOCOL; do
        sf="knowledge/$stub.md"
        [[ -f "$sf" ]] || continue
        case "$(head -1 "$sf")" in
            *DEPRECATED*) : ;;
            *) err "112" "$stub.md אינו stub מאוחד (שורה 1 ללא ⛔ DEPRECATED)" "השאר רק שלט-הפניה ל-VERIFICATION_PROTOCOL.md" ;;
        esac
        grep -q "VERIFICATION_PROTOCOL" "$sf" || err "112" "$stub.md לא מצביע ל-VERIFICATION_PROTOCOL.md" "הוסף הפניה"
        SLN=$(grep -c '' "$sf"); SLN=${SLN:-0}
        [[ "$SLN" -le 20 ]] || err "112" "$stub.md תפח ל-$SLN שורות" "השאר רק שלט-הפניה (≤20 שורות)"
    done
    ran 112

    # Gate 106: session_plan Owner + Scope.
    if [[ -n "$STAGED_LIB" ]] && [[ -f "knowledge/session_plan.md" ]]; then
        grep -qE "^Owner:" knowledge/session_plan.md || err "106" "session_plan חסר Owner:" "הוסף 'Owner: this session'"
        grep -qE "^Scope:" knowledge/session_plan.md || err "106" "session_plan חסר Scope:" "הוסף 'Scope: <file:axis>'"
        ran 106
    else
        napp 106
    fi

    # Gate 107: UI change visual log (advisory).
    STAGED_UI=$(git diff --cached --name-only | grep -E "^app_flutter/lib/screens/.*\.dart$" | head -1)
    if [[ -n "$STAGED_UI" ]]; then
        if [[ ! -f "knowledge/visual_log.md" ]] && [[ ! -f "knowledge/session_plan.md" || -z "$(grep -i 'screenshot\|visual' knowledge/session_plan.md 2>/dev/null)" ]]; then
            warn "107" "שינוי UI ללא visual log" "מומלץ: knowledge/visual_log.md או screenshot ב-session_plan"
        fi
    fi
    ran 107

    # Gate 108: CARRY_FORWARD exists.
    [[ -f "knowledge/CARRY_FORWARD.md" ]] || err "108" "CARRY_FORWARD חסר" "מכיל לקחים חוצי-sessions"; ran 108

    # Gate 109: closed sub-protocol -> CARRY_FORWARD (counts via bash builtin).
    if [[ -f "knowledge/session_plan.md" ]] && grep -q "sub-protocol" knowledge/session_plan.md 2>/dev/null; then
        DONE_COUNT=0; PENDING=0
        while IFS= read -r _l || [[ -n "$_l" ]]; do
            case "$_l" in *✅*) DONE_COUNT=$((DONE_COUNT+1));; esac
            case "$_l" in *⬜*) PENDING=$((PENDING+1));; esac
        done < knowledge/session_plan.md
        if [[ "$DONE_COUNT" -gt 5 && "$PENDING" -eq 0 ]]; then
            STAGED_CF=$(git diff --cached --name-only | grep "CARRY_FORWARD.md" | head -1)
            [[ -n "$STAGED_CF" ]] || warn "109" "sub-protocol הושלם בלי עדכון CARRY_FORWARD" "הוסף לקחים חוצי-sessions"
        fi
        ran 109
    else
        napp 109
    fi

    # Gate 110: audit log not empty.
    if [[ -f "knowledge/session_plan.md" ]] && grep -q "Audit log\|Audit Log" knowledge/session_plan.md 2>/dev/null; then
        AUDIT_LINES=$(awk '
          /[Aa]udit [Ll]og/ { in_section=1; next }
          in_section && /^##/ { in_section=0 }
          in_section && /^\|.*\|.*\|/ { count++ }
          END { print count+0 }' knowledge/session_plan.md 2>/dev/null)
        AUDIT_LINES=${AUDIT_LINES:-0}
        [[ "$AUDIT_LINES" -ge 2 ]] || warn "110" "Audit log קיים אבל ריק" "תעד קטגוריות שנסקרו"
        ran 110
    else
        napp 110
    fi

    # Gate 113: asset-generation contact-sheet.
    STAGED_CROP=$(git diff --cached --name-only | grep -E "scripts/(crop|render|gen|slice|montage)_.*\.py$|scripts/.*render.*\.py$|assets/.*\.(png|jpg|jpeg|webp)$" | head -1)
    if [[ -n "$STAGED_CROP" ]]; then
        STAGED_CARRY=$(git diff --cached --name-only | grep -E "knowledge/(CARRY_FORWARD|stuck_log)\.md$" | head -1)
        [[ -n "$STAGED_CARRY" ]] || warn "113" "crop/render script שונה — תעד visual verify ב-stuck_log/CARRY_FORWARD" "ראה CARRY_FORWARD #6"
    fi
    ran 113

    # Gate 114 (kLipskeyCatalog) -> Dart engine.

    # Gate 115: hot-file claims (advisory). bash builtin parsing (MSYS-safe).
    CLAIMS_FILE="knowledge/AGENT_COORDINATION.md"
    STAGED_NAMES=$(git diff --cached --name-only)
    if [[ -f "$CLAIMS_FILE" ]]; then
        _in_claims=""
        while IFS= read -r _l || [[ -n "$_l" ]]; do
            case "$_l" in
                *HOTFILE-CLAIMS-START*) _in_claims=1; continue;;
                *HOTFILE-CLAIMS-END*)   _in_claims="";  continue;;
            esac
            [[ -n "$_in_claims" ]] || continue
            case "$_l" in
                "- "*)
                    _cpath=${_l#- }; _cpath=${_cpath%%·*}; _cpath=${_cpath%% *}
                    [[ -z "$_cpath" ]] && continue
                    case "$STAGED_NAMES" in
                        *"$_cpath"*) warn "115" "hot-file claim על ${_cpath} — ${_l#- } — תאם/rebase לפני המשך";;
                    esac
                    ;;
            esac
        done < "$CLAIMS_FILE"
    fi
    ran 115   # hot-file claims scan always executes (body conditional on the file)

    # Gate 116: UI change requires visual_log staged (enforce; replay-skip).
    STAGED_UI2=$(echo "$STAGED_NAMES" | grep -E "^app_flutter/lib/(screens|widgets)/.*\.dart$" | head -1)
    if [[ -n "$STAGED_UI2" && -z "${VERIFIED_UI:-}" && -z "$IS_REPLAY" ]]; then
        STAGED_VLOG=$(git diff --cached --name-only | grep -E "knowledge/visual_log\.md$" | head -1)
        [[ -n "$STAGED_VLOG" ]] || err "116" "שינוי UI ($STAGED_UI2) בלי visual-verify מתועד" "עדכן knowledge/visual_log.md או VERIFIED_UI=1 לחירום"
    fi
    ran 116   # UI-visual-verify detection always executes
}

# ═══════════════════════════════════════════════════════════════════════════
#  Gate `reg` (R6): registry <-> RUNTIME parity. The set of ids that ACTUALLY
#  RAN this commit ($RAN_LEDGER — appended by every gate as it executes, plus the
#  engine's --emit-ran lines) MUST equal the registry's enforced set. Unlike v2
#  (which compared a STATIC constant), a gate that is commented-out / silently
#  dropped never lands in the ledger, so parity FAILS — proving the gate ran.
#  Malformed registry rows also FAIL (handled inside the Dart engine).
#  MUST be called LAST, after every other gate has had its chance to `ran`.
# ═══════════════════════════════════════════════════════════════════════════
gate_registry_parity() {
    local emitted_file out rc
    emitted_file="$(mktemp)" || { err "reg" "mktemp נכשל (parity)" "fail closed"; return; }
    ran "reg"
    # K3: the EXERCISED set = ran ∪ napp. `ran` = check body executed; `napp` =
    # applicability guard reached but false this commit (e.g. flutter tier on a
    # no-code commit). Both prove the gate's decision logic EXISTS; a silently
    # deleted gate appears in NEITHER and parity FAILS. (CI's audit mode forces
    # every guard true, so there the ledger is pure `ran`.)
    sort -u "$RAN_LEDGER" "$NAPP_LEDGER" > "$emitted_file"
    out=$(dart run "$REPO_ROOT/app_flutter/tool/protocol_check.dart" \
            --verify-registry \
            --emitted "$emitted_file" \
            --registry "$REPO_ROOT/protocol/gates.tsv" 2>&1)
    rc=$?
    rm -f "$emitted_file"
    if [[ $rc -ne 0 ]]; then
        echo "$out" | sed 's/^/   /'
        err "reg" "registry≠runtime — שער שלא רץ או מרשם פגום" \
            "כל id ב-gates.tsv(enforced) חייב לרוץ; הוסף ran <id> או תקן protocol/gates.tsv"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
#  RETRY / FINGERPRINT bookkeeping (preserved from v1)
# ═══════════════════════════════════════════════════════════════════════════
init_retry_state() {
    local fp ts rest rec_gates rec_head g prior_nums
    FINGERPRINT_FILE="$REPO_ROOT/.git/stuck_fingerprints.txt"
    touch "$FINGERPRINT_FILE"
    CURRENT_FP=$(git diff --cached --name-only | sort | sha256sum | cut -d' ' -f1 | head -c 12)
    HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "none")
    IS_RETRY="false"; PRIOR_GATES=""
    NOW=$(date +%s); FIVE_HOURS_AGO=$((NOW - 18000))
    while IFS=' ' read -r fp ts rest; do
        [[ "$ts" -gt "$FIVE_HOURS_AGO" ]] || continue
        rec_gates="${rest#gates=}"; rec_gates="${rec_gates%% *}"
        rec_head="${rest##*head=}"
        if [[ "$fp" == "$CURRENT_FP" ]]; then IS_RETRY="true"; PRIOR_GATES="$rec_gates"; break; fi
        if [[ "$HEAD_SHA" != "none" && "$rec_head" == "$HEAD_SHA" ]]; then IS_RETRY="true"; PRIOR_GATES="$rec_gates"; break; fi
    done < "$FINGERPRINT_FILE"
    PRIOR_HAS_CODE_TEST=""
    if [[ "$PRIOR_GATES" == v2:* ]]; then
        prior_nums="${PRIOR_GATES#v2:}"
        for g in ${prior_nums//,/ }; do
            [[ "$g" =~ ^[0-9]+$ ]] && (( g >= 31 && g <= 45 )) && (( g != 42 )) && { PRIOR_HAS_CODE_TEST="1"; break; }
        done
    elif [[ -n "$PRIOR_GATES" ]]; then
        PRIOR_HAS_CODE_TEST="1"
    fi
}

record_fingerprint() {
    echo "$CURRENT_FP $NOW gates=v2:${FAILED_GATES#,} head=$HEAD_SHA" >> "$FINGERPRINT_FILE"
    tail -100 "$FINGERPRINT_FILE" > "$FINGERPRINT_FILE.tmp" && mv "$FINGERPRINT_FILE.tmp" "$FINGERPRINT_FILE"
}

# ═══════════════════════════════════════════════════════════════════════════
#  RUNNER — orchestrates the gates, preserving v1 control flow exactly.
# ═══════════════════════════════════════════════════════════════════════════
run() {
    # P0 version generate must precede version gates 11/12 and Flutter.
    gate_version_generate
    init_retry_state

    echo ""
    echo "══════════════════════════════════════════════"
    echo "  פרוטוקול BuildSmart v2 — registry-driven"
    echo "══════════════════════════════════════════════"

    # Shared staged-file vars (computed once; many gates read them).
    STAGED_LIB=$(git diff --cached --name-only | grep -E "^app_flutter/lib/(screens|state|logic)/" | head -1)
    STAGED_HELPER=$(git diff --cached --name-only | grep -E "^app_flutter/lib/(logic|data)/" | head -1)
    STAGED_TEST=$(git diff --cached --name-only | grep -E "^app_flutter/test/.*_test\.dart$" | head -1)
    STAGED_KNOWLEDGE=$(git diff --cached --name-only | grep "knowledge/" | head -1)
    STAGED_WIRING=$(git diff --cached --name-only | grep "WIRING.md" | head -1)
    STUCK_LOG="knowledge/stuck_log.md"
    TEST_OUT=""; TEST_COUNT=""
    # R7: replay detection ONLY from on-disk rebase/am state — NOT the forgeable
    # $GIT_REFLOG_ACTION env (which the red team set to "amend" to skip tests).
    IS_REPLAY=""
    _GD=$(git rev-parse --git-dir 2>/dev/null || echo ".git")
    if [[ -d "$_GD/rebase-merge" || -d "$_GD/rebase-apply" ]]; then
        IS_REPLAY=1
    fi

    # ═══ K3 — AUDIT MODE: run every gate's body to emit a GENUINE `ran` ledger,
    #     skip the slow Flutter tier, dump the ledger, exit 0 (non-blocking). CI
    #     invokes this to diff the ledger against gates.tsv (REAL parity). We force
    #     applicability so each gate's check executes and records `ran` after it. ═══
    if [[ -n "$PROTOCOL_AUDIT_MODE" ]]; then
        # Force the shared applicability vars so conditional gate bodies execute.
        STAGED_LIB="app_flutter/lib/screens/_audit.dart"
        STAGED_HELPER="app_flutter/lib/logic/_audit_helper.dart"
        STAGED_TEST="app_flutter/test/_audit_test.dart"
        STAGED_KNOWLEDGE="knowledge/_audit.md"
        STAGED_WIRING="app_flutter/WIRING.md"
        IS_RETRY="false"; PRIOR_HAS_CODE_TEST=""; IS_REPLAY=""
        gate_engine_integrity
        gate_foundations
        gate_state
        gate_hook_integrity
        gate_planning
        gate_test_bookkeeping
        gate_quality
        gate_lang
        gate_save_safety
        gate_learning
        gate_knowledge
        run_content_engine
        gate_test_tier      # audit-short-circuits to record 31-40 (no real flutter)
        gate_final_safety
        ran "reg"
        sort -u "$RAN_LEDGER" "$NAPP_LEDGER" > "${PROTOCOL_AUDIT_LEDGER:-/dev/stdout}"
        rm -f "$RAN_LEDGER" "$NAPP_LEDGER"
        echo "🧾 audit ledger written to ${PROTOCOL_AUDIT_LEDGER:-stdout} (K3)" >&2
        exit 0
    fi

    # ── CHEAP gates (run before Flutter — fail-fast barrier) ──
    gate_engine_integrity   # R6: self-test + hash-pin BEFORE trusting the engine
    gate_foundations
    gate_state
    gate_hook_integrity
    gate_planning
    gate_test_bookkeeping
    gate_quality
    gate_lang
    gate_save_safety
    gate_learning      # 101/102/104/111 (cheap parts)
    gate_knowledge     # 106-116 (cheap)
    run_content_engine # ALL Dart content gates (cheap, deterministic) + RAN ledger

    # ── Fail-fast barrier: stop before the ~13-min Flutter tier ──
    if [[ "$FAIL" -gt 0 ]]; then
        echo ""
        echo "══════════════════════════════════════════════"
        echo "  ❌ $FAIL שגיאות בשערים מהירים — עוצר לפני Flutter"
        echo "  תקן ונסה שוב (חוסך ~13 דק' analyze/test/build)"
        echo "══════════════════════════════════════════════"
        record_fingerprint
        rm -f "$RAN_LEDGER" "$NAPP_LEDGER"
        exit 1
    fi

    # ── FLUTTER tier (analyze always; test skipped on replay) ──
    gate_test_tier
    # Gate 94 depends on TEST_OUT from the tier; final-safety runs AFTER it.
    gate_final_safety

    # ── R6: RUNTIME registry parity runs LAST, once every gate has had its
    #    chance to record into $RAN_LEDGER (incl. the Flutter tier ids). ──
    gate_registry_parity

    # ── Fingerprint on failure ──
    if [[ "$FAIL" -gt 0 ]]; then
        record_fingerprint
    fi
    rm -f "$RAN_LEDGER" "$NAPP_LEDGER"

    # ── Summary ──
    echo ""
    echo "══════════════════════════════════════════════"
    if [[ "$FAIL" -gt 0 ]]; then
        echo "  ❌ $FAIL שערים נכשלו · $WARN אזהרות"
        echo "  השמירה נחסמה — תקן ונסה שוב"
        echo "══════════════════════════════════════════════"
        exit 1
    else
        local SUMMARY="✅ כל השערים עברו (registry-driven)"
        [[ "$WARN" -gt 0 ]] && SUMMARY="$SUMMARY · $WARN אזהרות"
        echo "  $SUMMARY"
        echo "══════════════════════════════════════════════"
        exit 0
    fi
}

run
