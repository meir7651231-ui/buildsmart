    fi
    ran 47
    # 48 print(), 50 dart:html, 51 hard URL, 52 secrets -> Dart engine.

    NEW_TODO=$(git diff --cached lib/ 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E "// TODO[^:]|// FIXME[^:]" | head -1)
    [[ -z "$NEW_TODO" ]] || warn "49" "TODO/FIXME בלי הסבר"; ran 49

    # Gate 53 (secret files) — name-only, MSYS-safe, stays bash. Merged the 3 v1
