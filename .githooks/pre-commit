    else
        # ANTIPATTERN: (בדיוק) חייב להופיע ברשומה החדשה — לא ANTIPATTERN-EXAMPLE:
        # מקבל גם את הצורה המתויגת ANTIPATTERN[hook]: (סורק את ה-hook במקום lib/).
        NEW_LINES=$(git diff --cached "$STUCK_LOG" 2>/dev/null | grep "^+" | grep -v "^+++")
        if ! echo "$NEW_LINES" | grep -qE "^\+ANTIPATTERN(\[hook\])?:"; then
            err "102" "רשומה חסרה ANTIPATTERN" "הוסף שורת ANTIPATTERN: regex (בלי -EXAMPLE)"
        fi
        if ! echo "$NEW_LINES" | grep -qE "^\+RULE:"; then
            err "102" "רשומה חסרה RULE" "הוסף שורת RULE: כלל בעברית (בלי -EXAMPLE)"
        fi
    fi
fi

# שער 103: אנטי-פטרנים מ-stuck_log לא חוזרים בקוד החדש
# תיקון באג #11: pattern עובר ל-grep בלי shell expansion
# תיקון באג #32: shell-meta warning רצה גם כשאין Dart staged → false positives
# תיקון אודיט 2026-06-01: ANTIPATTERN[hook]: סורק את ה-hook ה-staged, לא *.dart
# הפתרון: מחשב staged diffs לפני הלולאה; כל pattern מנותב ליעד שלו
if [[ -f "$STUCK_LOG" ]]; then
    # החרגת קובץ הרגרסיה המיוצר: הוא מכיל את *כל* האנטי-פטרנים by-construction
    # (כל ANTIPATTERN נרשם בו כ-RegExp). בלי ההחרגה — כל regen ששינה הרבה שורות
    # מפיל את שער 103 false-positive על הפטרנים שתואמים את צורתם-שלהם. מקביל
    # ל-self-exclude של הבדיקה עצמה (contains('stuck_regression')).
    STAGED_DART_103=$(git diff --cached --name-only -- '*.dart' ':(exclude)*stuck_regression_test.dart' 2>/dev/null)
    STAGED_HOOK_103=$(git diff --cached --name-only -- ':/.githooks/pre-commit' 2>/dev/null)
    if [[ -n "$STAGED_DART_103" || -n "$STAGED_HOOK_103" ]]; then
        while IFS= read -r line; do
            # נתב לפי תיוג: ANTIPATTERN[hook]: → ה-hook, ANTIPATTERN: → *.dart
            if [[ "$line" == ANTIPATTERN\[hook\]:* ]]; then
                a103_target="hook"; pattern="${line#ANTIPATTERN\[hook\]: }"
            else
                a103_target="dart"; pattern="${line#ANTIPATTERN: }"
            fi
            [[ -z "$pattern" ]] && continue
            # חסום shell-injection chars לפני שימוש ב-pattern.
            # תיקון אודיט 2026-06-01: `echo "$p" | grep -qE` היה לא-דטרמיניסטי —
            # בסביבת ה-commit סימן 32/32 false-positive, אינטראקטיבית 0/32.
            # bash case/glob הוא builtin טהור — אפס variance של echo/grep בין סביבות.
            case "$pattern" in
                *'$('*|*'`'*|*'${'*)
                    warn "103" "אנטי-פטרן ב-stuck_log מכיל shell-meta (דלג): $pattern"
                    continue ;;
            esac
            if [[ "$a103_target" == "hook" ]]; then
                [[ -n "$STAGED_HOOK_103" ]] || continue
                # התעלם משורות שמתווספות כהערה (#) — תיעוד התיקון מותר
                MATCH=$(git diff --cached -- ':/.githooks/pre-commit' 2>/dev/null | grep "^+" | grep -v "^+++" | grep -vE "^\+\s*#" | grep -E -- "$pattern" 2>/dev/null | head -1)
            else
                [[ -n "$STAGED_DART_103" ]] || continue
                MATCH=$(git diff --cached -- '*.dart' ':(exclude)*stuck_regression_test.dart' 2>/dev/null | grep "^+" | grep -v "^+++" | grep -E -- "$pattern" 2>/dev/null | head -1)
            fi
            if [[ -n "$MATCH" ]]; then
                err "103" "אנטי-פטרן חזר: $pattern" "ראה stuck_log.md — הבעיה תועדה כבר"
            fi
        done < <(grep -E "^ANTIPATTERN(\[hook\])?:" "$STUCK_LOG" 2>/dev/null)
    fi
fi

# שער 104: re-generate stuck_regression_test אם stuck_log השתנה
STAGED_STUCK_LOG=$(git diff --cached --name-only | grep "stuck_log.md" | head -1)
if [[ -n "$STAGED_STUCK_LOG" ]]; then
    bash "$REPO_ROOT/app_flutter/scripts/generate_stuck_regression.sh" >/dev/null 2>&1
    # אם קובץ ה-test השתנה — הוסף ל-commit
    if ! git diff --quiet test/stuck_regression_test.dart 2>/dev/null; then
        git add test/stuck_regression_test.dart
        echo "🔁 stuck_regression_test.dart התעדכן אוטומטית"
    fi
fi

# שער 111: עקביות stuck_regression (דיווח קטלגן) — מספר ANTIPATTERN = מספר tests,
# ואין מספור כפול. תופס drift אחרי rebase (test מיוצר מ-commit ביניים לא תואם את
# stuck_log הממוזג) — בדיוק התרחיש שחזר ב-rebase הכפול. cheap (3 greps), רץ תמיד.
if [[ -f "knowledge/stuck_log.md" && -f "test/stuck_regression_test.dart" ]]; then
    AP_COUNT=$(grep -cE '^ANTIPATTERN(\[hook\])?:' knowledge/stuck_log.md); AP_COUNT=${AP_COUNT:-0}
    RT_COUNT=$(grep -cE 'test\("antipattern #' test/stuck_regression_test.dart); RT_COUNT=${RT_COUNT:-0}
    DUP_AP=$(grep -oE 'antipattern #[0-9]+' test/stuck_regression_test.dart | sort | uniq -d | head -1)
    [[ "$AP_COUNT" == "$RT_COUNT" ]] || err "111" "stuck_regression לא מסונכרן ($AP_COUNT ANTIPATTERN ≠ $RT_COUNT tests)" "הרץ scripts/generate_stuck_regression.sh"
    [[ -z "$DUP_AP" ]] || err "111" "מספור כפול ב-stuck_regression: $DUP_AP" "הרץ scripts/generate_stuck_regression.sh"
fi

# שער 112: stubs מאוחדים — TESTING/CHECKLISTS/BUG_INVESTIGATION חייבים להישאר
# שלטי-הפניה ל-VERIFICATION_PROTOCOL, ולא לברוא פרוטוקול-בדיקה מקביל. מונע מסוכן
# לעבוד לפי מסמך-בדיקה ישן ולהגיד "בדקתי לפי הפרוטוקול". bash builtin, רץ תמיד.
for stub in TESTING CHECKLISTS BUG_INVESTIGATION_PROTOCOL; do
    sf="knowledge/$stub.md"
    [[ -f "$sf" ]] || continue
    case "$(head -1 "$sf")" in
        *DEPRECATED*) : ;;
        *) err "112" "$stub.md אינו stub מאוחד (שורה 1 ללא ⛔ DEPRECATED)" "השאר רק שלט-הפניה ל-VERIFICATION_PROTOCOL.md" ;;
    esac
    grep -q "VERIFICATION_PROTOCOL" "$sf" || err "112" "$stub.md לא מצביע ל-VERIFICATION_PROTOCOL.md" "הוסף הפניה ל-VERIFICATION_PROTOCOL.md"
    SLN=$(grep -c '' "$sf"); SLN=${SLN:-0}
    [[ "$SLN" -le 20 ]] || err "112" "$stub.md תפח ל-$SLN שורות — תוכן-בדיקה זלג חזרה ל-stub" "השאר רק שלט-הפניה (≤20 שורות); התוכן ב-VERIFICATION_PROTOCOL §"
done

# רישום fingerprint אם נכשל
if [[ "$FAIL" -gt 0 ]]; then
    echo "$CURRENT_FP $NOW gates=v2:${FAILED_GATES#,} head=$HEAD_SHA" >> "$FINGERPRINT_FILE"
    # שמור רק 100 שורות אחרונות
    tail -100 "$FINGERPRINT_FILE" > "$FINGERPRINT_FILE.tmp" && mv "$FINGERPRINT_FILE.tmp" "$FINGERPRINT_FILE"
fi

