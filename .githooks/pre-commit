    ran 41 42 43 44
    BAD_COUNT=$(git diff --cached test/ 2>/dev/null | grep "^+" | grep -E "greaterThan\(0\)" | head -1)
    [[ -z "$BAD_COUNT" ]] || warn "41" "test עם greaterThan(0) — שביר על נתונים ריקים"

    # DX4 (v7): fire only on a NEW public top-level symbol with no covering test —
    # NOT merely "a lib/(logic|data) file was touched". In AUDIT mode the synthetic
    # context has no real diff, so force-exercise the gate's decision (record ran).
    if [[ -n "$PROTOCOL_AUDIT_MODE" ]]; then
        :   # ran 42 already recorded above; no real symbol scan in audit
    else
        _NEW_SYM=$(staged_new_untested_symbol)
        if [[ -n "$_NEW_SYM" ]]; then
            err "42" "סמל ציבורי חדש בלי בדיקה: $_NEW_SYM" "הוסף test/*_test.dart שמכסה את $_NEW_SYM (או יבא את הקובץ)"
        fi
    fi
    # B4 (v8): mutation_log was demanded on EVERY lib/(logic|data) edit — even a
    # one-line CONSTANT tweak that has no fault to inject (performative). Relax to
    # GENUINELY-NEW FAULT-INJECTABLE LOGIC: the staged helper diff must ADD a new
    # function/method declaration OR a control-flow/operator construct (if/for/
    # while/switch/ternary/comparison/arithmetic/return-with-expression). A pure
    # constant/string/list-literal change adds none of these → no mutation_log
    # demand. (gate 42/56 still demand a TEST for new public API; this only drops
    # the mutation-LOG ceremony on edits with nothing to mutate. bookkeep.sh still
    # stubs the entry when it IS demanded.)
    if [[ -n "$STAGED_HELPER" ]] && _staged_helper_adds_logic; then
        [[ -f "knowledge/mutation_log.md" ]] || err "43" "mutation_log חסר" "צור knowledge/mutation_log.md"
        if [[ -f "knowledge/mutation_log.md" ]]; then
            STAGED_MUT=$(git diff --cached --name-only | grep "mutation_log.md" | head -1)
            [[ -n "$STAGED_MUT" ]] || err "44" "mutation_log לא עודכן (לוגיקה חדשה הניתנת להזרקת-תקלה)" "תעד הזרקת תקלה ב-mutation_log.md (או bash scripts/bookkeep.sh)"
        fi
    fi
}

# B4 (v8): true when the staged lib/(logic|data) diff ADDS genuinely
# fault-injectable logic (a new fn/method, or a control-flow/operator construct)
# — as opposed to a constant/data-literal-only change with nothing to mutate.
_staged_helper_adds_logic() {
    local _hf _hfiles _added
    _hfiles=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
                | grep -E '^app_flutter/lib/(logic|data)/.*\.dart$' | sed 's#^app_flutter/##')
    [[ -z "$_hfiles" ]] && return 1
    while IFS= read -r _hf; do
        [[ -z "$_hf" ]] && continue
        # ADDED ('+') code lines, excluding pure comments. We strip // comments so a
        # `// if (x)` comment cannot count as logic.
        _added=$(git diff --cached -- "app_flutter/$_hf" "$_hf" 2>/dev/null \
                   | grep -E '^\+' | grep -vE '^\+\+\+' | sed -E 's://.*$::')
        # fault-injectable signals: control flow, a comparison/logical/arith
        # operator, a ternary, an early return-with-expression, or a new
        # function/method signature (`name(...) {` or `=> expr`).
        if printf '%s\n' "$_added" | grep -qE '\b(if|for|while|switch|else)\b|[!<>=]=|&&|\|\||[-+*/%]=| \? .* : |return[[:space:]]+[^;]|=>[[:space:]]*[^;{]|[A-Za-z0-9_]+[[:space:]]*\([^)]*\)[[:space:]]*\{'; then
            return 0
        fi
    done <<<"$_hfiles"
    return 1
}

