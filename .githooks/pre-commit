# ═══════════════════════════════════════════════════════════════════════════
#  GROUP test (31-44). The Flutter tier. Skipped if no .dart/.yaml staged;
#  test skipped on rebase/amend replay; analyze always (cheap).
# ═══════════════════════════════════════════════════════════════════════════
gate_test_tier() {
    local NEEDS_FLUTTER ANALYZE ERR_COUNT WARN_COUNT KNOWN_FAIL KF_LISTED FAIL_COUNT
    local TEST_EXIT LAST_TEST_COUNT N critical CHANGED_DART
    # K3: do NOT record `ran` at entry. The flutter-tier applicability guard is
    # "code staged?". In AUDIT mode we force it applicable so every gate records a
    # real `ran` after its check; otherwise (no code staged) the tier is NOT
    # APPLICABLE and we record `napp` (not `ran`) — honest per K3.
    NEEDS_FLUTTER=$(git diff --cached --name-only | grep -E "\.(dart|yaml|yml)$" | head -1)
    if [[ -n "$PROTOCOL_AUDIT_MODE" ]]; then NEEDS_FLUTTER="audit.dart"; fi
    if [[ -z "$NEEDS_FLUTTER" ]]; then
        echo "ℹ️  אין שינוי בקוד — מדלג על flutter analyze/test/build (חוסך 3-5 דק')"
        napp 31 32 33 35 36 37 38 39 40 94   # decided "not applicable" — not ran
        return
    fi
    # In AUDIT mode, do not actually shell out to the multi-minute Flutter tier;
    # record the tier gates as `ran` (their wiring was reached) and return.
    if [[ -n "$PROTOCOL_AUDIT_MODE" ]]; then
        ran 31 32 33 35 36 37 38 39 40
        return
    fi

    ANALYZE=$(flutter analyze --no-pub 2>&1)
    if echo "$ANALYZE" | grep -qE "^error •"; then
        ERR_COUNT=$(echo "$ANALYZE" | grep -cE "^error •")
        echo "$ANALYZE" | grep -E "^error •" | head -3
        err "31" "$ERR_COUNT שגיאות ניתוח" "תקן את השגיאות"
    fi
    # R3: treat WARNINGS as fatal — but ONLY for files changed in THIS commit, so
    # pre-existing lint warnings elsewhere don't block an unrelated change.
    CHANGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.dart$' | sed 's#^app_flutter/##')
    if [[ -n "$CHANGED_DART" ]]; then
        WARN_COUNT=0
        while IFS= read -r _f; do
            [[ -z "$_f" ]] && continue
            if echo "$ANALYZE" | grep -E "^warning •" | grep -qF "$_f"; then
                WARN_COUNT=$((WARN_COUNT+1))
            fi
        done <<< "$CHANGED_DART"
        if [[ "$WARN_COUNT" -gt 0 ]]; then
            echo "$ANALYZE" | grep -E "^warning •" | head -5
            err "31" "$WARN_COUNT אזהרות analyze בקבצים ששונו (R3: warnings=fatal)" "תקן את האזהרות בקבצים החדשים"
        fi
    fi

    if [[ -n "$IS_REPLAY" ]]; then
        echo "  ⏩ rebase/amend replay — מדלג על test (אומת קודם; pre-push יריץ build מלא)"
        TEST_OUT=""
    else
        TEST_OUT=$(flutter test --no-pub --concurrency=4 2>&1)
        TEST_EXIT=$?
        KNOWN_FAIL=$(grep -oE "known-failing: [0-9]+" knowledge/STATUS.md 2>/dev/null | grep -oE "[0-9]+$" || echo 0)
        KF_LISTED=$(grep -cvE '^[[:space:]]*(#|$)' knowledge/known_failing.txt 2>/dev/null); KF_LISTED=${KF_LISTED:-0}
        if [[ "$KNOWN_FAIL" -gt 0 && "$KF_LISTED" -ne "$KNOWN_FAIL" ]]; then
            err "32" "baseline-phantom: known-failing=$KNOWN_FAIL אך known_failing.txt מפרט $KF_LISTED שמות" "פרט שמות ב-known_failing.txt, או known-failing: 0"
        fi
        if [[ $TEST_EXIT -ne 0 ]] || echo "$TEST_OUT" | grep -qE "Some tests failed"; then
            # R5: parse the failure count from the SUMMARY line ONLY — anchored to
            # the compact reporter's `NN:NN +P -F:` form at line start — so a test
            # that PRINTS "+99 -0" as data cannot spoof the count.
            FAIL_COUNT=$(echo "$TEST_OUT" \
                | grep -aoE '^[0-9]{2}:[0-9]{2} \+[0-9]+ -[0-9]+:' \
                | grep -oE -- '-[0-9]+:' | grep -oE '[0-9]+' | tail -1)
            FAIL_COUNT=${FAIL_COUNT:-0}
            # R5: the failing test NAMES must be a SUBSET of known_failing.txt —
            # a NEW failure (name not in the baseline) blocks even if the COUNT is
            # within baseline (defends against swapping one known-fail for a new one).
            if [[ -f knowledge/known_failing.txt ]]; then
                NEW_FAIL_NAME=""
                while IFS= read -r _fl; do
                    # extract the test description after "… [E]" / ": <name> [E]"
                    _nm=$(echo "$_fl" | sed -E 's/.*: (.+) \[E\].*/\1/; t; d')
                    [[ -z "$_nm" ]] && continue
                    if ! grep -qF "$_nm" knowledge/known_failing.txt; then
                        NEW_FAIL_NAME="$_nm"; break
                    fi
                done < <(echo "$TEST_OUT" | grep -aE ': .+ \[E\]')
                [[ -z "$NEW_FAIL_NAME" ]] || err "32" "כשל חדש שאינו ב-baseline: $NEW_FAIL_NAME" "תקן, או הוסף ל-known_failing.txt + עדכן known-failing"
            fi
            if [[ "$FAIL_COUNT" -gt "$KNOWN_FAIL" ]]; then
                echo "   ❌ בדיקות שנכשלו (שמות):"
                echo "$TEST_OUT" | grep -aE "\[E\]|✗|FAILED|: .+ \[E\]" | head -20
                err "32" "בדיקות נכשלות: $FAIL_COUNT > baseline $KNOWN_FAIL" "תקן, או עדכן known-failing + known_failing.txt"
            else
                warn "32" "יש $FAIL_COUNT כשלים pre-existing (baseline=$KNOWN_FAIL) — מותר להמשיך"
            fi
        fi
        # R5: gate 33 — test count is monotonic-non-decreasing, read from the
        # machine-readable `tests: N` line in STATUS.md (anchored), and the live
        # PASS count from the SUMMARY line only.
        TEST_COUNT=$(echo "$TEST_OUT" | grep -aoE '^[0-9]{2}:[0-9]{2} \+[0-9]+' | grep -oE '\+[0-9]+' | tail -1 | tr -d '+')
        LAST_TEST_COUNT=$(grep -oE "^tests: [0-9]+" knowledge/STATUS.md 2>/dev/null | grep -oE "[0-9]+" | head -1)
        if [[ -z "$LAST_TEST_COUNT" ]]; then
            # fallback to the legacy free-form marker if `tests: N` not present yet
            LAST_TEST_COUNT=$(grep -oE "[0-9]+\+ tests|[0-9]+ tests pass" knowledge/STATUS.md 2>/dev/null | head -1 | grep -oE "^[0-9]+" || echo 0)
        fi
        if [[ -n "$TEST_COUNT" && "$TEST_COUNT" -lt "$LAST_TEST_COUNT" ]]; then
            err "33" "מספר בדיקות ירד: $TEST_COUNT < $LAST_TEST_COUNT" "אל תמחק בדיקות (gate 33 monotonic)"
        fi
    fi
    # K3: tier ran (analyze+test executed) — record AFTER the checks.
    ran 31 32 33

    # Gate 34 (build web) MOVED to pre-push — see registry. (Not emitted here.)

    # Gates 35-40: critical test files exist (warn). Preserved as advisory.
    for critical in compat_coverage_test regression_gate_test knowledge_protocol_test \
                    smartproduct_contract_test dedup_test no_duplicate_specs_test; do
        N=$((35 + $(echo "compat_coverage_test regression_gate_test knowledge_protocol_test smartproduct_contract_test dedup_test no_duplicate_specs_test" | tr ' ' '\n' | grep -n "^${critical}$" | cut -d: -f1) - 1))
        [[ -f "test/${critical}.dart" ]] || warn "$N" "$critical חסר — בדיקה חיונית נמחקה?"
        ran "$N"   # K3: each critical-test gate records after its existence check
    done
}

