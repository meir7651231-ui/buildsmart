rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// BuildSmart — Firestore Security Rules (S5 · server-connect).
// Project `buildsmart-b0b78` · Production mode (deny-by-default) — this file is
// the server-side RBAC that makes the client's role separation REAL.
// SSOT: SPEC-server-connect-MICRO rows S5.1–S5.8 + SPEC-server-connect
// §"אבטחה — מתווה-rules". Roles are Firebase Auth CUSTOM CLAIMS written ONLY by
// the `setRole` callable (functions/src/index.ts): `role: <r>` or `roles: [r…]`
// over contractor|manager|store|courier|worker, plus the bootstrap-only
// `admin: true`. The `users/{uid}.role` Firestore field is a READ MIRROR — the
// claims are the source of truth these rules read (request.auth.token).
//
// ⚠️ S5.7 — App Check: enforcement is a CONSOLE action, not a rules expression.
//    Firebase console → App Check → APIs → Cloud Firestore → Enforce (after the
//    clients ship with the App Check provider, S0.5). See rules_test/README.md.
//
// ⚠️ uid-MIGRATION STATE (launch Phase A/G) — these rules enforce the uid
//    contract PER COLLECTION at its actual landed state (verified against the
//    repo, not assumed):
//      • orders — OWNERSHIP IS LANDED. uid-A3 (commit 24b5bc2) added
//        `orders.contractorUid` = the placer's auth.uid (orders_engine.dart),
//        written by orders_firebase toDoc when signed-in. THIS is the ownership
//        key these rules use (see `ownsOrder`). `orders.contractorId` is the
//        legacy DISPLAY NAME (who→contractorId) and is NOT a uid — it is not
//        used for any gate. Seed/pre-A3 docs carry no contractorUid → owner-
//        unmatched but still manager/admin-readable (backward-tolerant).
//      • chat — FORWARD-READY (S1 uid join DEFERRED). `chatThreads.participants`
//        still carries ROLE NAMES ('contractor', 'store', …) and
//        `chatMessages.fromUid` is OMITTED (chat_firebase.dart header). The
//        participants/fromUid rules below implement the POST-S1 uid contract, so
//        current role-name writes/reads are DENIED to a non-manager by design —
//        DO NOT assume these fields are populated yet. The single swap point is
//        chat_firebase toDoc/fromDoc when S1 lands real uids.
//      • customers — FORWARD-READY. `customers.ownerId` is NOT yet written
//        (customers_firebase toDoc omits it), so an ownerId-scoped read matches
//        nothing today; a doc with no ownerId is manager/admin-only (backward-
//        tolerant — never hard-breaks an admin read).
//    Run/finish the uid migration (chat participants→uids + fromUid; customers
//    ownerId; orders storeId/courierId assignment) BEFORE relying on the
//    forward-ready gates for those collections.
//
// ⚠️ RULES ARE NOT FILTERS — the app's `FirestoreCollectionSource` currently
//    listens to WHOLE collections (`collection(...).snapshots()`, no `where`).
//    On participant-scoped collections (orders / chatThreads / chatMessages /
//    customers / finance*) a full-collection listen by a non-manager is DENIED
//    as a whole. Clients must scope their queries to what the rule can prove,
//    e.g. `chatThreads.where('participants', arrayContains: uid)` (the S4.1
//    contract) or orders `.where('contractorId'|'storeId'|'courierId', '==',
//    uid)`. The repos' guarded listeners log the denial and keep serving the
//    seed cache (never thrown to the UI) — but live data requires scoped
//    queries. Same consequence: a fresh-backend seed push
//    (`onFirstSnapshotEmpty → pushCacheToRemote`) only succeeds from a session
//    whose role may create those docs (manager/admin); seeding belongs to
//    dev/emulator or an admin session, not an arbitrary first client.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────

    /// Any authenticated caller (Firebase Auth — phone/email, S1).
    function isSignedIn() {
      return request.auth != null;
    }

    /// The bootstrap `admin: true` claim (functions/README — first admin).
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    /// Role check over BOTH claim shapes the setRole callable writes:
    /// single `role: 'store'` or multi `roles: ['store', 'courier']`.
    function hasRole(r) {
      return isSignedIn()
          && (request.auth.token.get('role', '') == r
              || (r in request.auth.token.get('roles', [])));
    }

    /// Manager is the app's god-role (dashboard / setStage / finance); admin
    /// (claims bootstrap) is a superset everywhere a manager is allowed.
    function isManager() {
      return hasRole('manager') || isAdmin();
    }

    // ── users/{uid} — S5.1 · doc-id = auth uid · {phone, role, fcmToken,
    //    displayName} ───────────────────────────────────────────────────────────
    // read: self or admin. write: self may maintain the own mirror doc
    // (fcmToken S6.1, displayName, phone) but may NEVER touch `role`/`roles` —
    // those fields are admin-only (the claim is the real source; the doc only
    // mirrors it for display). delete: self (S1.8 in-app account deletion —
    // Apple requirement: user.delete() + data deletion) or admin.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
          || (isSignedIn() && request.auth.uid == uid
              && !request.resource.data.keys().hasAny(['role', 'roles']));
      allow update: if isAdmin()
          || (isSignedIn() && request.auth.uid == uid
              && !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['role', 'roles']));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ── chatThreads/{threadId} — S5.2 · {participants:[uid], names, lastMsg,
    //    ts} ─────────────────────────────────────────────────────────────────────
    // read/write ONLY for a participant (`threadsFor` as a server law). create
    // requires the author to put themself in the NEW doc's participants; update
    // FREEZES participants (a participant may refresh the lastMsg/ts denorm —
    // the repo's full-doc upsert rewrites the same array, which passes — but
    // may not eject the peer or recruit others; membership changes are a
    // server/Functions concern). Pre-uid docs (role-name participants) never
    // match an auth.uid — see the migration header note.
    match /chatThreads/{threadId} {
      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
          && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.get('participants', [])
              == resource.data.participants;
      allow delete: if isSignedIn()
          && request.auth.uid in resource.data.participants;
    }

    /// The participants array of a thread — one extra doc read (billed) per
    /// rule evaluation; the price of keeping messages in their own collection.
    function threadParticipants(threadId) {
      return get(/databases/$(database)/documents/chatThreads/$(threadId))
          .data.participants;
    }

    // ── chatMessages/{messageId} — S5.3 · {threadId, fromUid, fromRole, text,
    //    ts} ─────────────────────────────────────────────────────────────────────
    // read: uid ∈ the parent thread's participants (get() lookup — queries must
    // pin `threadId` per S4.2 `where('threadId').orderBy(ts)`). create: only as
    // yourself (`fromUid == auth.uid` — no sender spoofing) and only into a
    // thread you participate in. Messages are immutable: no update/delete from
    // clients (moderation/retention is an admin/Functions concern, S8).
    match /chatMessages/{messageId} {
      allow read: if isSignedIn()
          && request.auth.uid in threadParticipants(resource.data.threadId);
      allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.auth.uid in
              threadParticipants(request.resource.data.threadId);
      allow update, delete: if false;
    }

    // ── customers/{customerId} — S5.4 · {name, phone, creditLimit, used,
    //    balance, ownerId} ──────────────────────────────────────────────────────
    // CREDIT DATA. read: manager/admin, OR the record's owner (`ownerId == uid`).
    // write: manager only. Everyone else (store/courier/worker/foreign
    // contractor) is blocked — the S5.8 "credit blocked" test.
    // ⚠️ FORWARD-READY (Phase G): `ownerId` is NOT yet written by the client
    // (customers_firebase toDoc omits it), so the owner branch matches NOTHING
    // today — every customers doc is effectively manager/admin-only right now.
    // The rule is shipped so the owner-scoped read lights up the moment an A-phase
    // stamps ownerId (the orders-A3 precedent). BACKWARD-TOLERANT: a doc with no
    // ownerId defaults to '' and never equals an auth.uid, so it stays manager/
    // admin-only — it never hard-breaks an admin read.
    match /customers/{customerId} {
      allow read: if isManager()
          || (isSignedIn()
              && resource.data.get('ownerId', '') == request.auth.uid);
      allow write: if isManager();
    }

    // ── orders/{orderId} — S5.5 · {projectId, lines[], sum, stage,
    //    siteAddress, contractorId(=display name), contractorUid(=auth.uid, the
    //    LANDED ownership key, A3), storeId, courierId, ts} ─────────────────────

    /// kManagerOrderFlow (lib/logic/manager_dashboard.dart) — the ONLY legal
    /// stage vocabulary.
    function orderStages() {
      return ['new', 'preparing', 'ready', 'pickup', 'transit', 'delivered'];
    }

    /// A stage-only update: every other field is frozen for store/courier.
    function onlyStageChanged() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['stage']);
    }

    /// One legal hop: the doc currently sits at [from] and moves to [to].
    /// Both sides read via `.get(...,'')` so a doc/delta missing `stage` yields a
    /// clean false (no evaluation error) instead of throwing — important now
    /// that the store/courier claim update may carry a `{storeUid}`/`{courierUid}`
    /// delta where the engine still re-evaluates this guard.
    function stageMove(from, to) {
      return resource.data.get('stage', '') == from
          && request.resource.data.get('stage', '') == to;
    }

    /// The STORE chain — kManagerOrderFlow's store stages, new→ready:
    /// new→preparing→ready (one hop at a time, mirroring `advance`).
    function storeStageMove() {
      return stageMove('new', 'preparing') || stageMove('preparing', 'ready');
    }

    /// The COURIER chain — ready/pickup→delivered:
    /// ready→pickup→transit→delivered (one hop at a time).
    function courierStageMove() {
      return stageMove('ready', 'pickup')
          || stageMove('pickup', 'transit')
          || stageMove('transit', 'delivered');
    }

    /// Assignment binding: once an order carries a storeId/courierId, ONLY that
    /// uid's session may work it; an empty/absent field (pre-assignment — the
    /// current toDoc never writes them) leaves the role-gate as the only gate.
    function unassignedOrMine(field) {
      return resource.data.get(field, '') == ''
          || resource.data.get(field, '') == request.auth.uid;
    }

    /// A4/A5 (claim-on-first-advance + shared pool) — the store stages an order
    /// may sit in while still UN-CLAIMED and visible to the whole store pool
    /// (the store chain new→preparing→ready). Mirrors `_kStorePoolStages`
    /// (orders_local.dart) — the client pool query and this read gate must agree.
    function storePoolStages() {
      return ['new', 'preparing', 'ready'];
    }

    /// A4/A5 — the courier pool stages (ready/pickup/transit) — mirrors
    /// `_kCourierPoolStages`.
    function courierPoolStages() {
      return ['ready', 'pickup', 'transit'];
    }

    /// A5 — is this a STORE pool order (un-claimed `storeUid` AND in a store
    /// stage)? Every store may READ it (the shared pool); the first to advance
    /// CLAIMS it (the update rule's no-steal then binds it).
    function inStorePool() {
      return resource.data.get('storeUid', '') == ''
          && resource.data.get('stage', '') in storePoolStages();
    }

    /// A5 — the courier analogue of [inStorePool].
    function inCourierPool() {
      return resource.data.get('courierUid', '') == ''
          && resource.data.get('stage', '') in courierPoolStages();
    }

    /// A4 — NO-STEAL claim guard for a uid-ownership [field] (storeUid /
    /// courierUid): the WRITE may leave the field empty, set it to the caller's
    /// OWN uid (the claim), or leave an already-mine value unchanged — but it may
    /// NEVER point the field at a value the caller does not own. Combined with
    /// the binding (only the owner/pool may update at all), this makes a steal of
    /// another party's claimed order impossible; a manager bypasses it entirely.
    function claimOnlySelf(field) {
      return request.resource.data.get(field, '') == ''
          || request.resource.data.get(field, '') == request.auth.uid;
    }

    /// A4 — the store update's changed-keys are exactly the stage hop, optionally
    /// plus its OWN claim field — never the peer's (`courierUid`) and never any
    /// business field. (The advance write is `set(merge:true)` of stage [+
    /// storeUid on the claim]; merge does not delete omitted fields, so the diff
    /// is precisely these keys.)
    function storeStageOrClaimOnly() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['stage', 'storeUid']);
    }

    /// A4 — the courier analogue: only `stage` (+ its own `courierUid` claim).
    function courierStageOrClaimOnly() {
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['stage', 'courierUid']);
    }

    /// The contractor's OWNERSHIP uid on an order. ⚠️ Phase-G correction: the
    /// LANDED uid field is `contractorUid` (uid-A3, commit 24b5bc2 —
    /// orders_engine.dart `Order.contractorUid` = the placer's auth.uid, written
    /// by orders_firebase toDoc only when non-empty). `contractorId` is the
    /// legacy DISPLAY NAME (`Order.who`), NOT a uid — keying ownership on it (as
    /// the pre-G rule did) compares a name to a uid and DENIES a contractor their
    /// own order. So ownership reads/keys on `contractorUid`. A legacy/seed doc
    /// that predates A3 carries no `contractorUid` (→ '') and is therefore
    /// owner-unmatched — manager/admin still reads it (backward-tolerant: an
    /// un-uid'd doc never hard-breaks an admin read), and a fresh A3 order
    /// carries the real uid so the owner matches. (`contractorId` is intentionally
    /// NOT a read fallback: it holds a name, which can never equal an auth.uid —
    /// accepting it would gate nothing and could leak by name-collision.)
    function ownsOrder() {
      return resource.data.get('contractorUid', '') == request.auth.uid;
    }

    // create: contractor, always at the flow head ('new'), bound to the author
    //   (`contractorUid == uid` — an order cannot be created in someone else's
    //   name; the LANDED A3 uid field, see ownsOrder above). manager/admin may
    //   also create at any legal stage (dashboard/seed/reset tooling). NOTE: the
    //   current contractor client must stamp contractorUid (signed-in) for its
    //   own create to pass — an empty contractorUid (signed-out / pre-A3 path)
    //   is denied creation by design, which is the intended hardening.
    // update: transition-per-role — claim-on-first-advance + shared pool (A4) —
    //   store:   new→preparing→ready, may CLAIM `storeUid` (empty→own only,
    //            no-steal); bound to its claim OR the un-claimed pool; the diff
    //            is stage[+storeUid] only;
    //   courier: ready→pickup→transit→delivered, may CLAIM `courierUid`
    //            (analogous);
    //   manager: the god-step (`setStage`) — any change whose stage is legal
    //            (incl. REASSIGNING storeUid/courierUid to any uid).
    // read: owner (contractorUid == uid) / claimant (storeUid|courierUid == uid)
    //   / the shared POOL (un-claimed order in the role's stages — A5) or
    //   manager/admin. Legacy storeId/courierId stay as a forward-tolerant read
    //   fallback (never written today; an empty field never equals a uid).
    // delete: manager only (`resetToSeed` cleanup is a manager/admin action).
    match /orders/{orderId} {
      allow read: if isManager()
          || (isSignedIn()
              && (ownsOrder()
                  || resource.data.get('storeUid', '') == request.auth.uid
                  || resource.data.get('courierUid', '') == request.auth.uid
                  || resource.data.get('storeId', '') == request.auth.uid
                  || resource.data.get('courierId', '') == request.auth.uid
                  || (hasRole('store') && inStorePool())
                  || (hasRole('courier') && inCourierPool())))
          ;
      allow create: if (hasRole('contractor')
              && request.resource.data.stage == 'new'
              && request.resource.data.get('contractorUid', '')
                  == request.auth.uid)
          || (isManager() && request.resource.data.stage in orderStages());
      allow update: if (hasRole('store')
              && storeStageOrClaimOnly()
              && storeStageMove()
              && unassignedOrMine('storeUid')
              && claimOnlySelf('storeUid')
              && request.resource.data.get('courierUid', '')
                  == resource.data.get('courierUid', ''))
          || (hasRole('courier')
              && courierStageOrClaimOnly()
              && courierStageMove()
              && unassignedOrMine('courierUid')
              && claimOnlySelf('courierUid')
              && request.resource.data.get('storeUid', '')
                  == resource.data.get('storeUid', ''))
          || (isManager() && request.resource.data.stage in orderStages());
      allow delete: if isManager();
    }

    // ── S5.6 — stock / siteNodes / projects / tasks / siteStageProgress ──────
    // The SSOT asks for project-ownership + role. The live docs do not yet
    // carry usable ownership joins (stock/tasks ship projectId:'' / none;
    // `projects` itself is still a const board pass-through the app never
    // writes; siteStageProgress doc-ids are bare "<productKey>#<idx>" flags) —
    // so the PRAGMATIC, documented enforcement here is: any signed-in user may
    // READ, and WRITES are gated to the roles that own each flow. Tightening to
    // per-project membership (`projects.members[]` / projectId get() joins) is
    // the post-uid-migration hardening step, alongside S8's server-side
    // validation.

    // stock — the store persona's inventory (`move`) + manager oversight.
    match /stock/{stockId} {
      allow read: if isSignedIn();
      allow write: if hasRole('store') || isManager();
    }

    // siteNodes — the site workspace structure (S3.S schema row); written by
    // the contractor running the site, overseen by manager.
    match /siteNodes/{nodeId} {
      allow read: if isSignedIn();
      allow write: if hasRole('contractor') || isManager();
    }

    // projects — {name, address, status, contractorId, members[]}. A contractor
    // may create/maintain a project bound to themself; manager everything.
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isManager()
          || (hasRole('contractor')
              && request.resource.data.get('contractorId', '')
                  == request.auth.uid);
      allow delete: if isManager();
    }

    // tasks — the worker↔manager flow: worker submits for review
    // (active/rejected→review), manager approves/rejects; both ride `status`
    // updates over the same docs.
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if hasRole('worker') || isManager();
    }

    // siteStageProgress — per-product install-stage done-flags (doc existence
    // == done), toggled from the contractor's site tools (and the worker's
    // install flow).
    match /siteStageProgress/{flagId} {
      allow read: if isSignedIn();
      allow write: if hasRole('contractor') || hasRole('worker') || isManager();
    }

    // ── finance* — S3.F wave · manager-only writes ───────────────────────────
    // financeApprovals {what, amount, by, status} · financePenalties {days,
    // perDay, amount, createdAt} · financePaymentTerms/active {termId}.
    // read: manager (+ the record's owner where an ownerId field exists —
    // future-proof; the current docs carry none, so they are manager-only).
    // write: manager only (decide / addPenalty / setPaymentTerm are manager
    // dashboard actions).

    match /financeApprovals/{approvalId} {
      allow read: if isManager()
          || (isSignedIn()
              && resource.data.get('ownerId', '') == request.auth.uid);
      allow write: if isManager();
    }

    match /financePenalties/{penaltyId} {
      allow read: if isManager()
          || (isSignedIn()
              && resource.data.get('ownerId', '') == request.auth.uid);
      allow write: if isManager();
    }

    match /financePaymentTerms/{termId} {
      allow read: if isManager()
          || (isSignedIn()
              && resource.data.get('ownerId', '') == request.auth.uid);
      allow write: if isManager();
    }

    // ── default — S5 deny-by-default ─────────────────────────────────────────
    // Anything not explicitly matched above (including any future collection
    // added without a rule) is denied for everyone. NOTE: the catalog (1,877
    // products) is intentionally NOT a collection here — it is bundled/R2-CDN
    // static JSON (SSOT §אזהרות), so no rule will ever exist for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
